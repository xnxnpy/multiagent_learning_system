<view class="container">
  <view class="tabs">
    <view 
      class="tab {{activeTab === index ? 'active' : ''}}" 
      wx:for="{{tabs}}" 
      wx:key="index"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      {{item}}
    </view>
  </view>

  <view class="tab-content">
    <view wx:if="{{activeTab === 0}}" class="form-section">
      <view class="form-item">
        <text class="form-label">用户名</text>
        <text class="form-value">{{userInfo.username || '-'}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">角色</text>
        <text class="form-value">{{userInfo.roleText}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">姓名</text>
        <input class="form-input" placeholder="请输入姓名" value="{{userInfo.real_name}}" data-field="userInfo.real_name" bindinput="onInput" />
      </view>
      <view class="form-item">
        <text class="form-label">邮箱</text>
        <input class="form-input" type="email" placeholder="请输入邮箱" value="{{userInfo.email}}" data-field="userInfo.email" bindinput="onInput" />
      </view>
      <button class="submit-btn" bindtap="updateBasicInfo" disabled="{{isSubmitting}}">
        {{isSubmitting ? '更新中...' : '保存修改'}}
      </button>
    </view>

    <view wx:if="{{activeTab === 1}}" class="form-section">
      <view class="form-item">
        <text class="form-label">专业</text>
        <input class="form-input" placeholder="请输入专业" value="{{profileData.major}}" data-field="major" bindinput="onProfileInput" />
      </view>
      <view class="form-item">
        <text class="form-label">年级</text>
        <input class="form-input" placeholder="请输入年级" value="{{profileData.grade}}" data-field="grade" bindinput="onProfileInput" />
      </view>
      <view class="form-item">
        <text class="form-label">学习目标</text>
        <input class="form-input" placeholder="请输入学习目标" value="{{profileData.goal}}" data-field="goal" bindinput="onProfileInput" />
      </view>
      <view class="form-item">
        <text class="form-label">知识水平</text>
        <input class="form-input" placeholder="请输入知识水平" value="{{profileData.knowledge_level}}" data-field="knowledge_level" bindinput="onProfileInput" />
      </view>
      <view class="form-item">
        <text class="form-label">学习风格</text>
        <input class="form-input" placeholder="请输入学习风格" value="{{profileData.learning_style}}" data-field="learning_style" bindinput="onProfileInput" />
      </view>
      <view class="form-item">
        <text class="form-label">编程能力</text>
        <input class="form-input" placeholder="请输入编程能力" value="{{profileData.coding_ability}}" data-field="coding_ability" bindinput="onProfileInput" />
      </view>
      <button class="submit-btn" bindtap="updateProfile" disabled="{{isSubmitting}}">
        {{isSubmitting ? '更新中...' : '保存画像'}}
      </button>
    </view>

    <view wx:if="{{activeTab === 2}}" class="form-section">
      <view class="form-item">
        <text class="form-label">旧密码</text>
        <input class="form-input" type="password" placeholder="请输入旧密码" value="{{oldPassword}}" data-field="oldPassword" bindinput="onInput" />
      </view>
      <view class="form-item">
        <text class="form-label">新密码</text>
        <input class="form-input" type="password" placeholder="请输入新密码(至少6位)" value="{{newPassword}}" data-field="newPassword" bindinput="onInput" />
      </view>
      <view class="form-item">
        <text class="form-label">确认新密码</text>
        <input class="form-input" type="password" placeholder="请再次输入新密码" value="{{confirmPassword}}" data-field="confirmPassword" bindinput="onInput" />
      </view>
      <button class="submit-btn" bindtap="changePassword" disabled="{{isSubmitting}}">
        {{isSubmitting ? '修改中...' : '修改密码'}}
      </button>
    </view>
  </view>
</view>