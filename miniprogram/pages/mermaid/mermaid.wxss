.mermaid-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 400rpx;
  color: #999;
  font-size: 28rpx;
}

.error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 20rpx;
}

.error-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.error-text {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 30rpx;
}

.code-block {
  width: 100%;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
}

.code-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.code-text {
  font-size: 24rpx;
  color: #333;
  font-family: monospace;
  white-space: pre-wrap;
  line-height: 1.6;
}

.image-container {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
}

.mermaid-image {
  width: 100%;
  display: block;
}
