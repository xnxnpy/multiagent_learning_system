.container { padding: 24rpx 28rpx 60rpx; background: #F7F5F0; min-height: 100vh; }
.page-title { font-size: 40rpx; font-weight: 700; }
.page-desc { font-size: 24rpx; color: #8A8FA3; margin: 8rpx 0 24rpx; }
.compose {
  background: #fff; border-radius: 16rpx; padding: 20rpx; margin-bottom: 24rpx;
  display: flex; flex-direction: column; gap: 12rpx;
}
.c-input {
  background: #F7F5F0; border-radius: 10rpx; padding: 14rpx 16rpx; font-size: 26rpx;
}
.c-textarea {
  background: #F7F5F0; border-radius: 10rpx; padding: 14rpx 16rpx;
  font-size: 26rpx; min-height: 140rpx; width: 100%; box-sizing: border-box;
}
.c-btn { margin: 0; background: #B0512C; border: none; }
.section-title { font-size: 28rpx; font-weight: 600; margin-bottom: 12rpx; }
.post {
  background: #fff; border-radius: 14rpx; padding: 22rpx; margin-bottom: 14rpx;
}
.post-head { display: flex; justify-content: space-between; font-size: 22rpx; color: #8A8FA3; }
.author { font-weight: 600; color: #2B2D42; }
.post-title { font-size: 30rpx; font-weight: 600; margin: 10rpx 0; }
.post-content { font-size: 26rpx; color: #4B5563; line-height: 1.6; white-space: pre-wrap; }
.post-actions { display: flex; gap: 12rpx; margin-top: 14rpx; }
.post-actions button { margin: 0; font-size: 22rpx; }
.like-btn.liked { background: #EEF2FF; color: #4338CA; }
.empty { text-align: center; color: #8A8FA3; padding: 30rpx 0; }
