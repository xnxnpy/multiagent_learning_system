.container { padding: 24rpx 28rpx 60rpx; background: #F7F5F0; min-height: 100vh; }
.page-title { font-size: 40rpx; font-weight: 700; }
.page-desc { font-size: 24rpx; color: #8A8FA3; margin: 8rpx 0 24rpx; }
.search-row { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.search-input { flex: 1; background: #fff; border-radius: 12rpx; padding: 16rpx 20rpx; font-size: 28rpx; }
.search-btn { background: #B0512C; color: #fff; border: none; margin: 0; }
.type-row { display: flex; gap: 12rpx; flex-wrap: wrap; margin-bottom: 24rpx; }
.type-chip {
  padding: 8rpx 20rpx; border-radius: 999rpx; background: #fff;
  font-size: 24rpx; color: #5A5E72; border: 1rpx solid #E5E7EB;
}
.type-chip.active { background: #2B2D42; color: #fff; border-color: #2B2D42; }
.section-title { font-size: 28rpx; font-weight: 600; margin: 20rpx 0 12rpx; }
.res-item {
  background: #fff; border-radius: 14rpx; padding: 20rpx; margin-bottom: 14rpx;
}
.res-type {
  display: inline-block; font-size: 20rpx; background: #EEF2FF; color: #4338CA;
  padding: 4rpx 12rpx; border-radius: 6rpx; margin-bottom: 8rpx;
}
.res-title { font-size: 28rpx; font-weight: 600; line-height: 1.4; }
.res-summary { font-size: 22rpx; color: #6B7280; margin-top: 8rpx; line-height: 1.5; }
.res-actions { display: flex; gap: 12rpx; margin-top: 14rpx; justify-content: flex-end; }
.res-actions button { margin: 0; font-size: 22rpx; }
.empty { text-align: center; color: #8A8FA3; padding: 30rpx 0; font-size: 26rpx; }
