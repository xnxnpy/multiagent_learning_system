.video-page {
  width: 100%;
  height: 100vh;
  background: #000;
  position: relative;
}

.video {
  width: 100%;
  height: 100%;
}

.overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  z-index: 100;
}

.back-btn {
  width: 100rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  border-radius: 30rpx;
  font-size: 26rpx;
  border: none;
  margin-right: 20rpx;
}

.title {
  flex: 1;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
}

.status {
  color: #999;
  font-size: 24rpx;
}