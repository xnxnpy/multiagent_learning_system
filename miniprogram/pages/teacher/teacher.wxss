/* pages/teacher/teacher.wxss */
.teacher-container {
  min-height: 100vh;
  background: #f5f7fa;
  display: flex;
  flex-direction: column;
  padding-bottom: 120rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.back-btn {
  font-size: 28rpx;
  color: #1677ff;
  padding: 8rpx 20rpx;
  border: 2rpx solid #1677ff;
  border-radius: 20rpx;
}

.header-left .breadcrumbs {
  font-size: 26rpx;
  color: #666;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.greeting {
  font-size: 28rpx;
  color: #333;
}

.logout-btn {
  font-size: 26rpx;
  color: #ff4d4f;
  padding: 8rpx 20rpx;
  border: 2rpx solid #ff4d4f;
  border-radius: 20rpx;
}

.main-content {
  flex: 1;
  padding: 30rpx;
  overflow-y: auto;
}

.tab-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.add-btn,
.export-btn {
  background: linear-gradient(135deg, #1677ff 0%, #4096ff 100%);
  color: #fff;
  border-radius: 30rpx;
  font-size: 26rpx;
  padding: 0 30rpx;
  height: 60rpx;
}

.filter-btn {
  background: #fff;
  color: #1677ff;
  border: 2rpx solid #1677ff;
  border-radius: 30rpx;
  font-size: 26rpx;
  padding: 0 30rpx;
  height: 60rpx;
  line-height: 56rpx;
}

.course-list,
.review-list,
.homework-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.course-card,
.review-card,
.homework-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
}

.course-header,
.review-header,
.homework-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.course-name,
.review-title,
.homework-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.course-status,
.homework-status {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.course-status.active,
.homework-status.published {
  background: #d9f7be;
  color: #52c41a;
}

.course-status.completed {
  background: #f0f0f0;
  color: #999;
}

.homework-status.pending {
  background: #fff2e8;
  color: #fa8c16;
}

.homework-status.graded {
  background: #e6f4ff;
  color: #1677ff;
}

.course-desc,
.review-desc,
.homework-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.course-meta,
.review-meta,
.homework-meta {
  display: flex;
  gap: 30rpx;
  margin-bottom: 20rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #999;
}

.course-actions,
.review-actions,
.homework-actions {
  display: flex;
  gap: 15rpx;
}

.action-btn {
  flex: 1;
  background: #f5f5f5;
  color: #666;
  border-radius: 30rpx;
  font-size: 26rpx;
  height: 60rpx;
}

.approve-btn {
  flex: 1;
  background: #52c41a;
  color: #fff;
  border-radius: 30rpx;
  font-size: 26rpx;
  height: 60rpx;
}

.reject-btn {
  flex: 1;
  background: #ff4d4f;
  color: #fff;
  border-radius: 30rpx;
  font-size: 26rpx;
  height: 60rpx;
}

.review-type {
  font-size: 24rpx;
  color: #1677ff;
}

.review-time {
  font-size: 22rpx;
  color: #999;
}

.stats-overview {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.stat-card {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #1677ff;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.student-table {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.table-header {
  display: flex;
  padding: 20rpx 30rpx;
  background: #fafafa;
  border-bottom: 1rpx solid #eee;
}

.th {
  flex: 1;
  font-size: 24rpx;
  color: #999;
  text-align: center;
}

.table-row {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.table-row:last-child {
  border-bottom: none;
}

.td {
  flex: 1;
  font-size: 26rpx;
  text-align: center;
}

.td.name {
  color: #333;
}

.td.score {
  color: #1677ff;
  font-weight: bold;
}

.td.progress {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.progress-bar {
  flex: 1;
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #1677ff 0%, #4096ff 100%);
}

.progress-text {
  font-size: 22rpx;
  color: #666;
  width: 60rpx;
}

.td.status {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.td.status.good {
  background: #d9f7be;
  color: #52c41a;
}

.td.status.normal {
  background: #fffbe6;
  color: #faad14;
}

.td.status.attention {
  background: #fff2e8;
  color: #ff4d4f;
}

.td.action-btn {
  background: #e6f4ff;
  color: #1677ff;
  border-radius: 20rpx;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
}

.report-charts {
  display: flex;
  gap: 20rpx;
}

.chart-card {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
}

.chart-title {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.bar-chart {
  display: flex;
  justify-content: space-around;
  align-items: flex-end;
  height: 200rpx;
}

.bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 60rpx;
}

.bar-fill {
  width: 40rpx;
  background: linear-gradient(180deg, #1677ff 0%, #4096ff 100%);
  border-radius: 8rpx 8rpx 0 0;
  margin-bottom: 10rpx;
}

.bar-label {
  font-size: 20rpx;
  color: #666;
}

.pie-chart {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto 20rpx;
}

.pie-bg {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #f0f0f0;
}

.pie-segment {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  clip-path: polygon(50% 50%, 50% 0%, 100% 0%, 100% 100%, 0% 100%, 0% 0%, 50% 0%);
}

.segment-1 {
  background: #52c41a;
  clip-path: polygon(50% 50%, 50% 0%, 100% 0%, 100% 50%);
  transform: rotate(0deg);
}

.segment-2 {
  background: #faad14;
  clip-path: polygon(50% 50%, 50% 0%, 100% 0%, 100% 100%, 50% 100%);
  transform: rotate(117deg);
}

.pie-legend {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}

.dot-1 { background: #52c41a; }
.dot-2 { background: #faad14; }
.dot-3 { background: #ff4d4f; }

.legend-item text {
  font-size: 24rpx;
  color: #666;
}

.bottom-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #fff;
  border-top: 1rpx solid #eee;
  padding: 15rpx 0 calc(15rpx + env(safe-area-inset-bottom));
  z-index: 999;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 10rpx 0;
}

.tab-icon {
  font-size: 36rpx;
  margin-bottom: 5rpx;
}

.tab-text {
  font-size: 22rpx;
  color: #999;
}

.tab-bar-item.active .tab-text {
  color: #1677ff;
  font-weight: bold;
}

.tab-bar-item.active .tab-icon {
  transform: scale(1.1);
}

.badge {
  position: absolute;
  top: 5rpx;
  right: 20%;
  background: #fa8c16;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
}