.container {
  min-height: 100vh;
  background: var(--color-bg-page);
  display: flex;
  flex-direction: column;
}

.page-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 30rpx 20rpx;
  background: var(--color-bg-card);
  border-bottom: 1rpx solid var(--color-border-light);
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--color-text-ink);
}

.page-tag {
  font-size: 24rpx;
  color: var(--color-success);
  background: var(--color-success-soft);
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

.tabs {
  display: flex;
  background: var(--color-bg-card);
  padding: 0 10rpx;
  border-bottom: 1rpx solid var(--color-border-light);
  overflow-x: auto;
  white-space: nowrap;
}

.tab {
  flex: 0 0 auto;
  text-align: center;
  padding: 24rpx 20rpx;
  font-size: 26rpx;
  color: var(--color-text-muted);
  position: relative;
}

.tab.active {
  color: var(--color-primary);
  font-weight: bold;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: var(--color-student);
  border-radius: 3rpx;
}

.tab-content {
  flex: 1;
  padding: 20rpx;
  height: calc(100vh - 180rpx);
}

.tab-pane {
  min-height: 100%;
}

.profile-card {
  background: var(--color-bg-card);
  border-radius: 24rpx;
  padding: 24rpx;
  border: 1rpx solid var(--color-border-light);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--color-text-ink);
}

.card-tag {
  font-size: 22rpx;
  color: var(--color-primary);
  background: var(--color-primary-pale);
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
}

.profile-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.profile-item {
  width: calc(50% - 10rpx);
}

.profile-item-full {
  width: 100%;
}

.profile-label {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-bottom: 8rpx;
}

.profile-value {
  font-size: 28rpx;
  color: var(--color-text-body);
}

.profile-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.profile-tags.warning .tag-item {
  background: var(--color-warning-soft);
  color: var(--color-warning);
}

.tag-item {
  font-size: 24rpx;
  color: var(--color-primary);
  background: var(--color-primary-pale);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
}

.empty-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--color-text-muted);
  display: block;
  margin-bottom: 20rpx;
}

.empty-btn {
  background: var(--color-student);
  color: var(--color-text-inverse);
  border-radius: 32rpx;
  font-size: 28rpx;
}

.path-content {
  background: var(--color-bg-card);
  border-radius: 24rpx;
  padding: 24rpx;
  border: 1rpx solid var(--color-border-light);
}

.path-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: var(--color-text-ink);
  margin-bottom: 24rpx;
}

.path-steps {
  padding-left: 10rpx;
}

.path-step {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  position: relative;
}

.path-step::before {
  content: '';
  position: absolute;
  left: 15rpx;
  top: 50rpx;
  width: 4rpx;
  height: calc(100% - 30rpx);
  background: var(--color-border-light);
}

.path-step:last-child::before {
  display: none;
}

.step-number {
  width: 40rpx;
  height: 40rpx;
  background: var(--color-bg-page-2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-right: 20rpx;
  flex-shrink: 0;
}

.path-step.done .step-number {
  background: var(--color-success);
  color: var(--color-text-inverse);
}

.step-content {
  flex: 1;
}

.step-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: var(--color-text-ink);
  margin-bottom: 4rpx;
}

.step-desc {
  font-size: 24rpx;
  color: var(--color-text-body);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.step-status {
  font-size: 28rpx;
  color: var(--color-text-muted);
}

.resource-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
  background: var(--color-bg-card);
  padding: 16rpx;
  border-radius: 24rpx;
  border: 1rpx solid var(--color-border-light);
}

.resource-tab {
  font-size: 24rpx;
  color: var(--color-text-muted);
  background: var(--color-bg-card-soft);
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
}

.resource-tab.active {
  color: var(--color-text-inverse);
  background: var(--color-primary);
}

.resource-content {
  background: var(--color-bg-card);
  border-radius: 24rpx;
  padding: 24rpx;
  min-height: 400rpx;
  border: 1rpx solid var(--color-border-light);
}

.resource-item {
  min-height: 300rpx;
}

.markdown-preview {
  line-height: 1.8;
}

.resource-text {
  font-size: 28rpx;
  color: var(--color-text-body);
  line-height: 1.8;
  white-space: pre-wrap;
}

.questions-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.question-item {
  padding: 20rpx;
  background: var(--color-bg-card-soft);
  border-radius: 20rpx;
  border: 1rpx solid var(--color-border-light);
}

.question-header {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.question-tag {
  font-size: 22rpx;
  color: var(--color-primary);
  background: var(--color-primary-pale);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.question-text {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: var(--color-text-ink);
  margin-bottom: 12rpx;
  line-height: 1.6;
}

.question-options {
  padding-left: 20rpx;
  margin-bottom: 12rpx;
}

.option-item {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-body);
  margin-bottom: 8rpx;
}

.question-answer {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-body);
  margin-bottom: 8rpx;
}

.question-answer::before {
  content: '答案：';
  font-weight: bold;
  color: var(--color-success);
}

.question-explain {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-body);
  padding: 12rpx;
  background: var(--color-primary-pale);
  border-radius: 12rpx;
}

.code-preview {
  line-height: 1.6;
}

.code-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.code-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--color-text-ink);
}

.code-tag {
  font-size: 22rpx;
  color: var(--color-warning);
  background: var(--color-warning-soft);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.code-desc {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-body);
  margin-bottom: 12rpx;
}

.code-block {
  background: var(--color-primary-deep);
  padding: 20rpx;
  border-radius: 16rpx;
}

.code-text {
  font-size: 24rpx;
  color: var(--color-primary-pale);
  font-family: monospace;
  white-space: pre-wrap;
  line-height: 1.6;
}

.video-script {
  line-height: 1.6;
}

.script-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: var(--color-text-ink);
  margin-bottom: 20rpx;
}

.scene-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.scene-item {
  padding: 16rpx;
  background: var(--color-bg-card-soft);
  border-radius: 16rpx;
  border-left: 6rpx solid var(--color-student);
}

.scene-title {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  color: var(--color-text-ink);
  margin-bottom: 8rpx;
}

.scene-desc {
  font-size: 24rpx;
  color: var(--color-text-body);
}

.glossary-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.glossary-card {
  background: var(--color-bg-card-soft);
  padding: 20rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--color-border-light);
}

.term-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: var(--color-student);
  margin-bottom: 8rpx;
}

.term-def {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-body);
  margin-bottom: 8rpx;
}

.term-example {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.knowledge-link {
  line-height: 1.6;
}

.link-stats {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-muted);
  margin-bottom: 20rpx;
}

.node-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.node-tag {
  font-size: 24rpx;
  color: var(--color-text-body);
  background: var(--color-primary-pale);
  padding: 10rpx 16rpx;
  border-radius: 20rpx;
}

.tutor-sessions {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.session-item {
  background: var(--color-bg-card);
  border-radius: 24rpx;
  padding: 24rpx;
  border: 1rpx solid var(--color-border-light);
}

.session-title {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-muted);
  margin-bottom: 16rpx;
}

.chat-messages {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.chat-msg {
  padding: 16rpx;
  border-radius: 16rpx;
  max-width: 85%;
}

.msg-user {
  background: var(--color-student-pale);
  align-self: flex-end;
}

.msg-assistant {
  background: var(--color-primary-pale);
  align-self: flex-start;
}

.msg-label {
  display: block;
  font-size: 22rpx;
  font-weight: bold;
  color: var(--color-text-muted);
  margin-bottom: 8rpx;
}

.msg-content {
  font-size: 28rpx;
  color: var(--color-text-body);
  line-height: 1.6;
}

.eval-content {
  background: var(--color-bg-card);
  border-radius: 24rpx;
  padding: 24rpx;
  border: 1rpx solid var(--color-border-light);
}

.eval-stats {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.eval-stat {
  flex: 1;
  text-align: center;
  background: var(--color-bg-card-soft);
  padding: 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--color-border-light);
}

.eval-value {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: var(--color-primary);
}

.eval-label {
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.eval-grade {
  display: inline-block;
  font-size: 28rpx;
  font-weight: bold;
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.eval-grade.grade-A {
  background: var(--color-success-soft);
  color: var(--color-success);
}

.eval-grade.grade-B {
  background: var(--color-info-soft);
  color: var(--color-info);
}

.eval-grade.grade-C {
  background: var(--color-warning-soft);
  color: var(--color-warning);
}

.eval-grade.grade-D, .eval-grade.grade-N {
  background: var(--color-error-soft);
  color: var(--color-error);
}

.eval-analysis {
  margin-top: 16rpx;
}

.analysis-section {
  margin-bottom: 20rpx;
}

.analysis-label {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  color: var(--color-text-body);
  margin-bottom: 12rpx;
}

.analysis-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.analysis-tags.success .analysis-tag {
  background: var(--color-success-soft);
  color: var(--color-success);
}

.analysis-tags.danger .analysis-tag {
  background: var(--color-error-soft);
  color: var(--color-error);
}

.analysis-tag {
  font-size: 24rpx;
  padding: 10rpx 16rpx;
  border-radius: 20rpx;
}

.suggestion-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.suggestion-item {
  font-size: 26rpx;
  color: var(--color-text-body);
  padding-left: 16rpx;
  border-left: 4rpx solid var(--color-student);
}
