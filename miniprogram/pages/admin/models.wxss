.page-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
}

.tabs {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 24rpx;
  color: #666;
  transition: all 0.2s;
}

.tab.active {
  color: #4F46E5;
  font-weight: 600;
  border-bottom: 4rpx solid #4F46E5;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.card-tag {
  font-size: 22rpx;
  color: #9ca3af;
  background: #f3f4f6;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.empty-state {
  text-align: center;
  padding: 60rpx 0;
}

.empty-icon {
  font-size: 64rpx;
  display: block;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #9ca3af;
}

.provider-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f9fafb;
}

.provider-item:last-child { border-bottom: none; }

.provider-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
  display: block;
  margin-bottom: 4rpx;
}

.provider-meta {
  font-size: 22rpx;
  color: #9ca3af;
  display: block;
}

.provider-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.action-link {
  font-size: 26rpx;
  padding: 8rpx 16rpx;
}

.action-link.delete { color: #ef4444; }

.model-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f9fafb;
}

.model-row:last-child { border-bottom: none; }

.model-agent {
  font-size: 26rpx;
  color: #4F46E5;
  background: #eef2ff;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.model-value {
  text-align: right;
}

.model-name {
  font-size: 26rpx;
  color: #374151;
  font-weight: 500;
  display: block;
}

.model-provider {
  font-size: 22rpx;
  color: #9ca3af;
  display: block;
}

.voice-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f9fafb;
}

.voice-item:last-child { border-bottom: none; }

.voice-name {
  font-size: 28rpx;
  color: #374151;
  font-weight: 500;
  display: block;
}

.voice-meta {
  font-size: 22rpx;
  color: #9ca3af;
}

.btn {
  height: 72rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
}

.btn.small {
  height: 56rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
}

.btn.primary {
  background: linear-gradient(135deg, #4F46E5 0%, #6366F1 100%);
  color: #fff;
}
