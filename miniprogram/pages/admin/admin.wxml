<view class="admin-container">
  <view class="header">
    <view class="header-left">
      <view class="back-btn" bindtap="goBack">← 返回</view>
      <text class="breadcrumbs">管理员端 / {{currentTabName}}</text>
    </view>
    <view class="header-right">
      <text class="greeting">晚上好，{{userName}} 👋</text>
      <view class="logout-btn" bindtap="logout">退出登录</view>
    </view>
  </view>

  <view class="main-content">
    <view wx:if="{{currentTab === 0}}" class="tab-content">
      <view class="section-header">
        <text class="section-title">用户管理</text>
        <button class="add-btn" bindtap="addUser">+ 添加用户</button>
      </view>
      <view class="user-table">
        <view class="table-header">
          <text class="th">用户名</text>
          <text class="th">角色</text>
          <text class="th">状态</text>
          <text class="th">注册时间</text>
          <text class="th">操作</text>
        </view>
        <view class="table-row" wx:for="{{users}}" wx:key="id">
          <text class="td">{{item.username}}</text>
          <text class="td role {{item.role}}">{{item.roleText}}</text>
          <text class="td status {{item.status}}">{{item.status === 'active' ? '正常' : '禁用'}}</text>
          <text class="td">{{item.createdAt}}</text>
          <view class="td actions">
            <button class="mini-btn" bindtap="editUser" data-id="{{item.id}}">编辑</button>
            <button class="mini-btn danger" bindtap="toggleUserStatus" data-id="{{item.id}}" data-status="{{item.status}}">{{item.status === 'active' ? '禁用' : '启用'}}</button>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{currentTab === 4}}" class="tab-content">
      <view class="section-header">
        <text class="section-title">系统监控</text>
        <button class="clear-btn" bindtap="clearLogs">清空日志</button>
      </view>
      <view class="log-section">
        <text class="log-title">系统日志</text>
        <scroll-view scroll-y class="log-list">
          <view class="log-item" wx:for="{{systemLogs}}" wx:key="id">
            <text class="log-time">{{item.timestamp}}</text>
            <text class="log-level {{item.level}}">{{item.levelText}}</text>
            <text class="log-message">{{item.message}}</text>
          </view>
        </scroll-view>
      </view>
    </view>
  </view>

  <view class="bottom-tab-bar">
    <view class="tab-bar-item {{currentTab === 0 ? 'active' : ''}}" bindtap="switchTab" data-tab="0">
      <text class="tab-icon">👥</text>
      <text class="tab-text">用户管理</text>
    </view>
    <view class="tab-bar-item {{currentTab === 1 ? 'active' : ''}}" bindtap="switchTab" data-tab="1">
      <text class="tab-icon">⚙️</text>
      <text class="tab-text">系统配置</text>
    </view>
    <view class="tab-bar-item {{currentTab === 2 ? 'active' : ''}}" bindtap="switchTab" data-tab="2">
      <text class="tab-icon">🤖</text>
      <text class="tab-text">模型管理</text>
    </view>
    <view class="tab-bar-item {{currentTab === 3 ? 'active' : ''}}" bindtap="switchTab" data-tab="3">
      <text class="tab-icon">🛡️</text>
      <text class="tab-text">内容安全</text>
    </view>
    <view class="tab-bar-item {{currentTab === 4 ? 'active' : ''}}" bindtap="switchTab" data-tab="4">
      <text class="tab-icon">📊</text>
      <text class="tab-text">系统监控</text>
    </view>
    <view class="tab-bar-item {{currentTab === 5 ? 'active' : ''}}" bindtap="switchTab" data-tab="5">
      <text class="tab-icon">💾</text>
      <text class="tab-text">数据备份</text>
    </view>
  </view>
</view>