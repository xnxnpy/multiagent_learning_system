.page-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
}

.tabs {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 24rpx;
  color: #666;
  transition: all 0.2s;
}

.tab.active {
  color: #4F46E5;
  font-weight: 600;
  border-bottom: 4rpx solid #4F46E5;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.card-tag {
  font-size: 22rpx;
  color: #9ca3af;
  background: #f3f4f6;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.card-action {
  font-size: 24rpx;
  color: #4F46E5;
}

.config-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
}

.config-info { flex: 1; }

.config-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #374151;
  display: block;
  margin-bottom: 8rpx;
}

.config-desc {
  font-size: 24rpx;
  color: #9ca3af;
}

.add-row {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.word-input {
  width: 100%;
  height: 72rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background: #f9fafb;
}

.category-tabs {
  display: flex;
  gap: 16rpx;
}

.cat-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.cat-tab.active {
  border-color: #4F46E5;
  background: #eef2ff;
  color: #4F46E5;
  font-weight: 600;
}

.empty-state {
  text-align: center;
  padding: 60rpx 0;
}

.empty-icon {
  font-size: 64rpx;
  display: block;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #9ca3af;
}

.word-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f9fafb;
}

.word-item:last-child { border-bottom: none; }

.word-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.word-text {
  font-size: 28rpx;
  color: #374151;
}

.word-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.word-tag.danger { background: #fef2f2; color: #ef4444; }
.word-tag.success { background: #f0fdf4; color: #16a34a; }

.action-link {
  font-size: 26rpx;
  padding: 8rpx 16rpx;
}

.action-link.delete { color: #ef4444; }

.log-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f9fafb;
}

.log-item:last-child { border-bottom: none; }

.log-message {
  font-size: 26rpx;
  color: #374151;
  margin-bottom: 6rpx;
  display: block;
}

.log-meta {
  display: flex;
  justify-content: space-between;
}

.log-category {
  font-size: 20rpx;
  color: #6366f1;
  background: #eef2ff;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

.log-time {
  font-size: 22rpx;
  color: #9ca3af;
}

.review-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f9fafb;
}

.review-item:last-child { border-bottom: none; }

.review-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.review-type {
  font-size: 24rpx;
  color: #6b7280;
  background: #f3f4f6;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
}

.status-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.status-tag.warning { background: #fef3c7; color: #d97706; }
.status-tag.success { background: #d1fae5; color: #059669; }
.status-tag.danger { background: #fee2e2; color: #dc2626; }

.review-content {
  font-size: 26rpx;
  color: #374151;
  line-height: 1.5;
  margin-bottom: 8rpx;
  display: block;
}

.review-comment {
  font-size: 24rpx;
  color: #6b7280;
  font-style: italic;
  margin-bottom: 6rpx;
  display: block;
}

.review-time {
  font-size: 22rpx;
  color: #9ca3af;
  display: block;
  margin-bottom: 12rpx;
}

.review-actions {
  display: flex;
  gap: 16rpx;
}

.btn {
  height: 72rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
}

.btn.full { width: 100%; }

.btn.small {
  height: 56rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
}

.btn.primary {
  background: linear-gradient(135deg, #4F46E5 0%, #6366F1 100%);
  color: #fff;
}

.btn.danger {
  background: #ef4444;
  color: #fff;
}

.btn[disabled] { opacity: 0.5; }
