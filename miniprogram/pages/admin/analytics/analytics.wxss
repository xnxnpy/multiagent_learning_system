.container { padding: 24rpx 28rpx 60rpx; background: #F7F5F0; min-height: 100vh; }
.page-title { font-size: 40rpx; font-weight: 700; }
.page-desc { font-size: 24rpx; color: #8A8FA3; margin: 8rpx 0 20rpx; }
.kpis { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 20rpx; }
.kpi {
  width: calc(50% - 6rpx); background: #fff; border-radius: 12rpx;
  padding: 20rpx; text-align: center; box-sizing: border-box;
}
.kpi .v { display: block; font-size: 40rpx; font-weight: 700; color: #2B2D42; }
.kpi.danger .v { color: #DC2626; }
.kpi.ok .v { color: #16A34A; }
.kpi .l { font-size: 22rpx; color: #8A8FA3; }
.card {
  background: #fff; border-radius: 14rpx; padding: 20rpx; margin-bottom: 16rpx;
}
.card-title { font-size: 26rpx; font-weight: 600; margin-bottom: 16rpx; }
.daily-row { display: flex; align-items: flex-end; gap: 4rpx; height: 200rpx; }
.daily-col {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  justify-content: flex-end; height: 100%; min-width: 0;
}
.daily-bar {
  width: 70%; background: #B0512C; border-radius: 4rpx 4rpx 0 0;
  min-height: 4rpx;
}
.daily-label { font-size: 14rpx; color: #8A8FA3; margin-top: 4rpx; transform: rotate(-40deg); transform-origin: center; }
.daily-val { font-size: 14rpx; color: #2B2D42; }
.hour-row { display: flex; align-items: flex-end; gap: 2rpx; height: 160rpx; }
.hour-col {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  justify-content: flex-end; height: 100%;
}
.hour-bar { width: 80%; background: #4F46E5; border-radius: 3rpx; min-height: 4rpx; }
.hour-label { font-size: 14rpx; color: #8A8FA3; margin-top: 4rpx; }
.share-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 14rpx; }
.share-name { width: 140rpx; font-size: 24rpx; color: #4B5563; }
.share-track { flex: 1; height: 16rpx; background: #E5E7EB; border-radius: 999rpx; overflow: hidden; }
.share-fill { height: 100%; background: #2B2D42; border-radius: 999rpx; }
.share-val { width: 80rpx; font-size: 22rpx; color: #2B2D42; text-align: right; }
.empty { text-align: center; color: #8A8FA3; padding: 24rpx 0; font-size: 24rpx; }
