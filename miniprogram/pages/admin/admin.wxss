/* pages/admin/admin.wxss */
.admin-container {
  min-height: 100vh;
  background: #f5f7fa;
  display: flex;
  flex-direction: column;
  padding-bottom: 120rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.back-btn {
  font-size: 28rpx;
  color: #1677ff;
  padding: 8rpx 20rpx;
  border: 2rpx solid #1677ff;
  border-radius: 20rpx;
}

.header-left .breadcrumbs {
  font-size: 26rpx;
  color: #666;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.greeting {
  font-size: 28rpx;
  color: #333;
}

.logout-btn {
  font-size: 26rpx;
  color: #ff4d4f;
  padding: 8rpx 20rpx;
  border: 2rpx solid #ff4d4f;
  border-radius: 20rpx;
}

.main-content {
  flex: 1;
  padding: 30rpx;
  overflow-y: auto;
}

.tab-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.add-btn {
  background: linear-gradient(135deg, #1677ff 0%, #4096ff 100%);
  color: #fff;
  border-radius: 30rpx;
  font-size: 26rpx;
  padding: 0 30rpx;
  height: 60rpx;
}

.filter-btn {
  background: #fff;
  color: #1677ff;
  border: 2rpx solid #1677ff;
  border-radius: 30rpx;
  font-size: 26rpx;
  padding: 0 30rpx;
  height: 60rpx;
  line-height: 56rpx;
}

.user-table {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.table-header {
  display: flex;
  padding: 20rpx 30rpx;
  background: #fafafa;
  border-bottom: 1rpx solid #eee;
}

.th {
  flex: 1;
  font-size: 24rpx;
  color: #999;
  text-align: center;
}

.table-row {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.table-row:last-child {
  border-bottom: none;
}

.td {
  flex: 1;
  font-size: 26rpx;
  text-align: center;
}

.td.role {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.td.role.student {
  background: #e6f7ff;
  color: #1890ff;
}

.td.role.teacher {
  background: #f6ffed;
  color: #52c41a;
}

.td.role.admin {
  background: #fff7e6;
  color: #fa8c16;
}

.td.status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.td.status.active {
  background: #d9f7be;
  color: #52c41a;
}

.td.status.disabled {
  background: #fff2e8;
  color: #ff4d4f;
}

.td.actions {
  display: flex;
  justify-content: center;
  gap: 15rpx;
}

.mini-btn {
  background: #e6f4ff;
  color: #1677ff;
  border-radius: 20rpx;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
}

.mini-btn.danger {
  background: #fff2e8;
  color: #ff4d4f;
}

.config-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.config-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
}

.config-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.config-label {
  font-size: 28rpx;
  color: #333;
}

.config-switch {
  transform: scale(0.8);
}

.config-input {
  width: 100%;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
}

.config-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}

.duration-options {
  display: flex;
  gap: 15rpx;
}

.duration-option {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #666;
}

.duration-option.active {
  background: #e6f4ff;
  color: #1677ff;
  font-weight: bold;
}

.save-config-btn {
  background: linear-gradient(135deg, #1677ff 0%, #4096ff 100%);
  color: #fff;
  border-radius: 30rpx;
  font-size: 30rpx;
  height: 80rpx;
  margin-top: 20rpx;
}

.model-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.model-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
}

.model-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.model-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.model-status {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.model-status.active {
  background: #d9f7be;
  color: #52c41a;
}

.model-status.offline {
  background: #fff2e8;
  color: #ff4d4f;
}

.model-info {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.info-item {
  font-size: 24rpx;
  color: #666;
}

.model-actions {
  display: flex;
  gap: 15rpx;
}

.action-btn {
  flex: 1;
  background: #f5f5f5;
  color: #666;
  border-radius: 30rpx;
  font-size: 26rpx;
  height: 60rpx;
}

.audit-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.audit-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
}

.audit-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.audit-type {
  font-size: 24rpx;
  color: #1677ff;
}

.audit-risk {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.audit-risk.high {
  background: #fff2e8;
  color: #ff4d4f;
}

.audit-risk.medium {
  background: #fffbe6;
  color: #faad14;
}

.audit-risk.low {
  background: #e6f7ff;
  color: #1890ff;
}

.audit-content {
  display: block;
  font-size: 26rpx;
  color: #333;
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.audit-meta {
  display: flex;
  gap: 30rpx;
  margin-bottom: 20rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #999;
}

.audit-actions {
  display: flex;
  gap: 15rpx;
}

.approve-btn {
  flex: 1;
  background: #52c41a;
  color: #fff;
  border-radius: 30rpx;
  font-size: 26rpx;
  height: 60rpx;
}

.reject-btn {
  flex: 1;
  background: #ff4d4f;
  color: #fff;
  border-radius: 30rpx;
  font-size: 26rpx;
  height: 60rpx;
}

.monitor-overview {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.monitor-card {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  text-align: center;
}

.monitor-icon {
  display: block;
  font-size: 40rpx;
  margin-bottom: 10rpx;
}

.monitor-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #1677ff;
  margin-bottom: 10rpx;
}

.monitor-label {
  font-size: 24rpx;
  color: #999;
}

.log-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
}

.log-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.log-list {
  max-height: 400rpx;
}

.log-item {
  display: flex;
  align-items: center;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.log-item:last-child {
  border-bottom: none;
}

.log-time {
  font-size: 22rpx;
  color: #999;
  width: 160rpx;
}

.log-level {
  font-size: 22rpx;
  font-weight: bold;
  width: 100rpx;
}

.log-level.error { color: #ff4d4f; }
.log-level.warning { color: #faad14; }
.log-level.info { color: #1677ff; }

.log-message {
  flex: 1;
  font-size: 24rpx;
  color: #666;
}

.backup-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.backup-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
}

.backup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.backup-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.backup-size {
  font-size: 24rpx;
  color: #999;
}

.backup-meta {
  display: flex;
  gap: 30rpx;
  margin-bottom: 20rpx;
}

.restore-btn {
  background: #e6f4ff;
  color: #1677ff;
  border-radius: 30rpx;
  font-size: 26rpx;
  height: 60rpx;
}

.create-backup-btn {
  background: linear-gradient(135deg, #1677ff 0%, #4096ff 100%);
  color: #fff;
  border-radius: 30rpx;
  font-size: 30rpx;
  height: 80rpx;
  margin-top: 20rpx;
}

.bottom-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #fff;
  border-top: 1rpx solid #eee;
  padding: 15rpx 0 calc(15rpx + env(safe-area-inset-bottom));
  z-index: 999;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 10rpx 0;
}

.tab-icon {
  font-size: 36rpx;
  margin-bottom: 5rpx;
}

.tab-text {
  font-size: 22rpx;
  color: #999;
}

.tab-bar-item.active .tab-text {
  color: #1677ff;
  font-weight: bold;
}

.tab-bar-item.active .tab-icon {
  transform: scale(1.1);
}

.badge {
  position: absolute;
  top: 5rpx;
  right: 20%;
  background: #fa8c16;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
}