.container { padding: 24rpx 28rpx 60rpx; background: #F7F5F0; min-height: 100vh; }
.page-title { font-size: 40rpx; font-weight: 700; }
.page-desc { font-size: 24rpx; color: #8A8FA3; margin: 8rpx 0 20rpx; }
.stats-grid { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 20rpx; }
.stat {
  width: calc(33.33% - 8rpx); background: #fff; border-radius: 12rpx;
  padding: 16rpx; text-align: center; box-sizing: border-box;
}
.stat .v { display: block; font-size: 32rpx; font-weight: 700; color: #2B2D42; }
.stat.warn .v { color: #DC2626; }
.stat .l { font-size: 20rpx; color: #8A8FA3; }
.btn-col { display: flex; flex-direction: column; gap: 12rpx; margin-bottom: 24rpx; }
.op-btn { margin: 0; border: none; font-size: 24rpx; }
.op-btn.warn { background: #FEF3C7; color: #B45309; }
.op-btn.danger { background: #FEE2E2; color: #B91C1C; }
.section-title { font-size: 28rpx; font-weight: 600; margin-bottom: 12rpx; }
.doc {
  display: flex; align-items: center; background: #fff;
  border-radius: 12rpx; padding: 18rpx; margin-bottom: 12rpx;
}
.doc-main { flex: 1; min-width: 0; }
.doc-name { display: block; font-size: 26rpx; font-weight: 500; word-break: break-all; }
.doc-meta { font-size: 20rpx; color: #8A8FA3; }
.doc-del { color: #DC2626; font-size: 24rpx; padding: 8rpx; }
.empty { text-align: center; color: #8A8FA3; padding: 30rpx 0; }
