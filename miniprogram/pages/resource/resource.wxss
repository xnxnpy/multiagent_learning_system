/* 浮动辅导助手按钮 */
.float-btn {
  position: fixed;
  right: 30rpx;
  bottom: 120rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6366F1, #4F46E5);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(99, 102, 241, 0.4);
  z-index: 100;
}

.float-icon {
  font-size: 40rpx;
  color: #fff;
}

/* 辅导浮窗 */
.float-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 200;
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
  padding: 20rpx;
}

.float-panel {
  width: 600rpx;
  height: 800rpx;
  background: #fff;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.15);
}

.float-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #6366F1, #4F46E5);
  color: #fff;
}

.float-title {
  font-size: 28rpx;
  font-weight: 600;
}

.float-close {
  font-size: 32rpx;
  padding: 8rpx;
}

.float-chat-box {
  flex: 1;
  padding: 16rpx;
  overflow-y: auto;
}

.float-msg {
  display: flex;
  margin-bottom: 20rpx;
  align-items: flex-start;
}

.float-msg.right {
  flex-direction: row-reverse;
}

.float-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4F46E5, #6366F1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
  color: #fff;
}

.float-avatar.user {
  background: #E0E7FF;
}

.float-bubble {
  max-width: 70%;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.float-bubble.ai {
  background: #F3F4F6;
  border-top-left-radius: 4rpx;
}

.float-bubble.user {
  background: linear-gradient(135deg, #4F46E5, #6366F1);
  color: #fff;
  border-top-right-radius: 4rpx;
}

.float-input-area {
  display: flex;
  gap: 12rpx;
  padding: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  background: #fff;
}

.float-input-row {
  display: flex;
  gap: 12rpx;
  padding: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  background: #fff;
}

.float-input {
  flex: 1;
  height: 68rpx;
  background: #F3F4F6;
  border-radius: 34rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
}

.float-send {
  width: 100rpx;
  height: 68rpx;
  background: linear-gradient(135deg, #4F46E5, #6366F1);
  color: #fff;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}