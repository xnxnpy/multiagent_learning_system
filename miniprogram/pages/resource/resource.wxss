/* ============================================================
 * 学习资源页 — 小程序单列垂直卡片布局
 * 设计令牌: app.wxss 定义的 CSS 变量
 * ============================================================ */

.resource-container {
  min-height: 100vh;
  background: var(--color-bg-page);
  display: flex;
  flex-direction: column;
}

/* ============ 顶部操作区 ============ */
.action-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: var(--color-bg-card);
  border-bottom: 1rpx solid var(--color-border-light);
}

.topic-tag {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: var(--color-text-body);
  background: var(--color-primary-pale);
  padding: 12rpx 24rpx;
  border-radius: 16rpx;
  font-weight: 500;
  flex: 1;
  min-width: 0;
}

.topic-label {
  font-size: 22rpx;
  color: var(--color-primary-deep);
  font-weight: 600;
  letter-spacing: 0.03em;
  flex-shrink: 0;
}

.topic-value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}

.topic-tag.placeholder {
  color: var(--color-text-faint);
  background: var(--color-bg-page-2);
  font-style: italic;
}

.regen-btn-sm {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 68rpx;
  padding: 0 24rpx;
  margin-left: 16rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, var(--color-student) 0%, #c9623a 100%);
  color: var(--color-text-inverse);
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 0.01em;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(176, 81, 44, 0.20);
  transition: all 0.15s;
  flex-shrink: 0;
  box-sizing: border-box;
}

.regen-btn-sm::after {
  border: none;
}

.regen-btn-sm:active {
  background: linear-gradient(135deg, #964527 0%, #a84624 100%);
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 16rpx rgba(176, 81, 44, 0.26);
}

.regen-btn-sm[disabled] {
  opacity: 0.6;
  background: var(--color-border-strong);
  box-shadow: none;
  transform: none;
}

.btn-icon {
  font-size: 26rpx;
  line-height: 1;
}

.btn-text {
  font-size: 26rpx;
  font-weight: 600;
}

/* ============ 个性化推荐卡 ============ */
.recommend-card {
  display: flex;
  gap: 20rpx;
  padding: 28rpx 32rpx;
  background: var(--color-bg-card);
  border-bottom: 1rpx solid var(--color-border-light);
  align-items: flex-start;
}

.recommend-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.recommend-body {
  flex: 1;
  min-width: 0;
}

.recommend-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-ink);
  margin-bottom: 6rpx;
}

.recommend-desc {
  font-size: 22rpx;
  color: var(--color-text-muted);
  line-height: 1.6;
}

/* ============ Tab 栏 ============ */
.tabs-scroll {
  white-space: nowrap;
  background: var(--color-bg-card);
  border-bottom: 1rpx solid var(--color-border-light);
}

.tabs-track {
  display: inline-flex;
  gap: 12rpx;
  padding: 16rpx 32rpx;
}

.tab-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
  background: var(--color-bg-page-2);
  color: var(--color-text-muted);
  font-size: 24rpx;
  font-weight: 500;
  transition: all 0.15s;
  flex-shrink: 0;
  border: 1rpx solid transparent;
}

.tab-chip:active {
  transform: scale(0.97);
}

.tab-chip.active {
  background: var(--color-primary);
  color: var(--color-text-inverse);
  box-shadow: 0 2rpx 8rpx rgba(43, 45, 66, 0.18);
  border-color: var(--color-primary);
}

.tab-chip-icon {
  font-size: 28rpx;
}

.tab-chip-label {
  font-size: 24rpx;
}

/* ============ Canvas 区域 ============ */
.canvas-area {
  display: flex;
  flex-direction: column;
  padding: 24rpx 32rpx;
  background: var(--color-bg-card);
  border-bottom: 1rpx solid var(--color-border-light);
}

.canvas-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.canvas-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-ink);
}

.canvas-viewport {
  flex: 1;
  background: var(--color-bg-card-soft);
  border-radius: 24rpx;
  border: 1rpx solid var(--color-border-light);
  overflow: hidden;
}

.canvas-node {
  width: 100%;
  min-height: 600rpx;
}

/* ============ 重新生成按钮 ============ */
.regen-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 28rpx;
  background: var(--color-warning-soft);
  color: var(--color-warning);
  font-size: 24rpx;
  font-weight: 500;
  border: none;
  transition: all 0.15s;
}

.regen-btn:active {
  background: #FDE68A;
  transform: scale(0.97);
}

.list-toolbar {
  display: flex;
  justify-content: flex-end;
  padding: 8rpx 0 16rpx;
}

/* ============ 质量门控卡 ============ */
.quality-gate {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 28rpx;
  background: var(--color-warning-soft);
  border-radius: 20rpx;
  border: 1rpx solid var(--color-warning);
  margin-bottom: 20rpx;
}

.qg-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.qg-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.qg-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-warning);
}

.qg-desc {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.qg-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 28rpx;
  background: var(--color-warning);
  color: var(--color-text-inverse);
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.qg-btn:active {
  opacity: 0.85;
}

/* ============ 内容滚动区 ============ */
.content-scroll {
  flex: 1;
  height: 0;
}

.content-inner {
  padding: 24rpx 32rpx 48rpx;
}

/* ============ 生成中提示 ============ */
.generating-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 28rpx;
  background: var(--color-primary-pale);
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.gen-spinner {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid var(--color-primary-light);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.gen-text {
  font-size: 26rpx;
  color: var(--color-primary-deep);
  font-weight: 500;
}

/* ============ 空状态 ============ */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 48rpx;
  text-align: center;
}

.empty-emoji {
  font-size: 96rpx;
  margin-bottom: 32rpx;
  opacity: 0.8;
}

.empty-heading {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-ink);
  margin-bottom: 12rpx;
}

.empty-text {
  font-size: 26rpx;
  color: var(--color-text-muted);
  line-height: 1.7;
  max-width: 520rpx;
  margin-bottom: 40rpx;
}

.empty-btn {
  height: 88rpx;
  padding: 0 48rpx;
  background: var(--color-student);
  color: var(--color-text-inverse);
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(176, 81, 44, 0.22);
}

.empty-btn:active {
  background: #964527;
  transform: translateY(-2rpx);
}

.empty-inline {
  text-align: center;
  padding: 60rpx 0;
  font-size: 26rpx;
  color: var(--color-text-faint);
}

/* ============ 资源卡片 ============ */
.res-card {
  background: var(--color-bg-card);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--color-border-light);
  box-shadow: 0 2rpx 6rpx rgba(29, 31, 51, 0.04);
}

.res-head {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.res-icon {
  font-size: 44rpx;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary-pale);
  border-radius: 16rpx;
  flex-shrink: 0;
}

.code-card .res-icon {
  background: var(--color-info-soft);
}

.res-head-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.res-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-ink);
  line-height: 1.35;
}

.res-desc {
  font-size: 24rpx;
  color: var(--color-text-muted);
  line-height: 1.6;
}

/* ============ 资源图片 ============ */
.res-images {
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.res-img-wrap {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.res-img {
  width: 100%;
  border-radius: 16rpx;
  border: 1rpx solid var(--color-border-light);
}

.res-img-caption {
  font-size: 22rpx;
  color: var(--color-text-muted);
  text-align: center;
}

/* ============ 资源正文 ============ */
.res-body {
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--color-text-body);
  margin-bottom: 20rpx;
  word-break: break-word;
}

.res-body rich-text {
  display: block;
}

.res-body ::v-deep h1,
.res-body ::v-deep h2,
.res-body ::v-deep h3 {
  color: var(--color-text-ink);
  font-weight: 700;
  margin-top: 32rpx;
  margin-bottom: 16rpx;
}

.res-body ::v-deep h1 { font-size: 36rpx; }
.res-body ::v-deep h2 { font-size: 32rpx; }
.res-body ::v-deep h3 { font-size: 30rpx; }

.res-body ::v-deep p {
  margin-bottom: 20rpx;
}

.res-body ::v-deep ul,
.res-body ::v-deep ol {
  padding-left: 32rpx;
  margin-bottom: 20rpx;
}

.res-body ::v-deep li {
  margin-bottom: 12rpx;
}

.res-body ::v-deep strong {
  color: var(--color-text-ink);
  font-weight: 700;
}

.res-body ::v-deep code {
  font-family: 'SF Mono', 'Consolas', monospace;
  background: var(--color-primary-pale);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: var(--color-primary-deep);
}

.res-body ::v-deep blockquote {
  border-left: 6rpx solid var(--color-student);
  padding: 12rpx 24rpx;
  margin: 24rpx 0;
  background: var(--color-student-pale);
  border-radius: 0 12rpx 12rpx 0;
  color: var(--color-text-body);
}

.res-body ::v-deep pre {
  background: #fff;
  border: 1rpx solid var(--color-border-light);
  border-radius: 16rpx;
  padding: 24rpx;
  overflow-x: auto;
  margin: 24rpx 0;
}

.res-body ::v-deep pre code {
  background: transparent;
  color: #24292e;
  padding: 0;
  font-size: 24rpx;
}

/* ============ Mermaid 流程图 ============ */
.res-mermaid {
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: var(--color-bg-page-2);
  border-radius: 16rpx;
}

.mermaid-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-ink);
  margin-bottom: 16rpx;
  display: block;
}

.mermaid-item {
  margin-bottom: 12rpx;
}

.mermaid-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: var(--color-bg-card);
  border-radius: 12rpx;
  border: 1rpx solid var(--color-border-light);
  font-size: 24rpx;
  color: var(--color-text-body);
}

.mermaid-btn:active {
  background: var(--color-primary-pale);
}

.mermaid-arrow {
  color: var(--color-primary);
  font-weight: 700;
}

/* ============ 卡片底部 ============ */
.res-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--color-border-light);
}

.res-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 500;
  background: var(--color-bg-page-2);
  color: var(--color-text-muted);
}

.tag-primary {
  background: var(--color-primary-pale);
  color: var(--color-primary-deep);
}

.tag-info {
  background: var(--color-info-soft);
  color: var(--color-info);
}

/* ============ 视频 ============ */
.video-wrap {
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.video-player {
  width: 100%;
  height: 420rpx;
}

.video-ph {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 24rpx;
  background: var(--color-bg-page-2);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  gap: 12rpx;
}

.play-emoji {
  font-size: 56rpx;
  opacity: 0.6;
}

.video-ph-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-ink);
}

.video-ph-meta {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.video-ph-tip {
  font-size: 22rpx;
  color: var(--color-text-faint);
}

/* ============ 答题卡 ============ */
.answer-card {
  background: var(--color-bg-card);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--color-border-light);
  box-shadow: 0 2rpx 6rpx rgba(29, 31, 51, 0.04);
}

.answer-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.answer-card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-ink);
}

.answer-card-total {
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.answer-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.answer-cell {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: var(--color-bg-page-2);
  color: var(--color-text-body);
  font-size: 26rpx;
  font-weight: 600;
  border: 1rpx solid var(--color-border-light);
  transition: all 0.15s;
}

.answer-cell:active {
  transform: scale(0.95);
}

.view-switch {
  display: flex;
  background: var(--color-bg-page-2);
  border-radius: 12rpx;
  padding: 6rpx;
}

.switch-item {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-muted);
  border-radius: 10rpx;
  transition: all 0.15s;
}

.switch-item.on {
  background: var(--color-bg-card);
  color: var(--color-primary);
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(29, 31, 51, 0.08);
}

/* ============ 题目卡片 ============ */
.quiz-card {
  background: var(--color-bg-card);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--color-border-light);
  box-shadow: 0 2rpx 6rpx rgba(29, 31, 51, 0.04);
}

.quiz-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--color-border-light);
}

.nav-btn {
  height: 72rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-page-2);
  border-radius: 36rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-body);
  border: none;
}

.nav-btn:active {
  background: var(--color-primary-pale);
  color: var(--color-primary-deep);
}

.nav-ind {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-ink);
}

.quiz-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.quiz-num {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-ink);
}

.quiz-tag {
  padding: 8rpx 18rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.quiz-tag.danger {
  background: var(--color-error-soft);
  color: var(--color-error);
}

.quiz-tag.warning {
  background: var(--color-warning-soft);
  color: var(--color-warning);
}

.quiz-tag.success {
  background: var(--color-success-soft);
  color: var(--color-success);
}

.quiz-tag.info {
  background: var(--color-info-soft);
  color: var(--color-info);
}

.quiz-q {
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--color-text-body);
  margin-bottom: 24rpx;
}

.quiz-q rich-text {
  display: block;
}

/* 选项 */
.quiz-opts {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.opt-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 24rpx;
  background: var(--color-bg-page-2);
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.15s;
  min-height: 88rpx;
}

.opt-row:active {
  background: var(--color-bg-card-soft);
}

.opt-row.picked {
  background: var(--color-student-pale);
  border-color: var(--color-student);
}

.opt-rad {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--color-bg-card);
  border: 2rpx solid var(--color-border);
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-text-inverse);
  flex-shrink: 0;
  margin-top: 2rpx;
}

.opt-row.picked .opt-rad {
  background: var(--color-student);
  border-color: var(--color-student);
}

.opt-label {
  font-size: 28rpx;
  color: var(--color-text-body);
  line-height: 1.5;
  flex: 1;
}

/* 答题输入 */
.quiz-input {
  width: 100%;
  height: 88rpx;
  background: var(--color-bg-page-2);
  border: 2rpx solid var(--color-border-light);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--color-text-body);
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.quiz-input:focus {
  border-color: var(--color-primary);
  background: var(--color-bg-card);
}

.quiz-textarea {
  width: 100%;
  min-height: 240rpx;
  background: var(--color-bg-page-2);
  border: 2rpx solid var(--color-border-light);
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 26rpx;
  color: var(--color-text-body);
  line-height: 1.6;
  box-sizing: border-box;
  margin-bottom: 24rpx;
  font-family: 'SF Mono', 'Consolas', monospace;
}

.quiz-textarea:focus {
  border-color: var(--color-primary);
  background: var(--color-bg-card);
}

/* 测试用例 */
.test-cases {
  margin-bottom: 24rpx;
  padding: 20rpx;
  background: var(--color-bg-page-2);
  border-radius: 12rpx;
}

.tc-title {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-muted);
  margin-bottom: 12rpx;
  display: block;
}

.tc-item {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-body);
  font-family: 'SF Mono', 'Consolas', monospace;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 88rpx;
  background: var(--color-student);
  color: var(--color-text-inverse);
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 700;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(176, 81, 44, 0.22);
  transition: all 0.15s;
}

.submit-btn:active {
  background: #964527;
  transform: translateY(-2rpx);
}

/* 答题反馈 */
.quiz-feedback {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: var(--color-bg-page-2);
}

.fb-text {
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
}

.fb-text.ok {
  color: var(--color-success);
}

.fb-text.bad {
  color: var(--color-error);
}

/* ============ 代码卡片 ============ */
.code-meta {
  padding: 20rpx;
  background: var(--color-bg-page-2);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.code-meta-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.code-k {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-muted);
  flex-shrink: 0;
  min-width: 140rpx;
}

.code-v {
  font-size: 24rpx;
  color: var(--color-text-body);
  flex: 1;
}

.code-pre {
  font-family: 'SF Mono', 'Consolas', monospace;
  white-space: pre-wrap;
  word-break: break-all;
}

.code-body {
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx solid var(--color-border-light);
  padding: 24rpx;
  margin-bottom: 20rpx;
  overflow-x: auto;
}

.code-body rich-text {
  display: block;
  font-family: 'SF Mono', 'Consolas', monospace;
  font-size: 24rpx;
  line-height: 1.6;
  color: #24292e;
}

.run-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 28rpx;
  background: var(--color-primary);
  color: var(--color-text-inverse);
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.run-btn:active {
  background: var(--color-primary-deep);
}

/* ============ 阅读按钮 ============ */
.read-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 28rpx;
  background: var(--color-primary-pale);
  color: var(--color-primary-deep);
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.read-btn:active {
  background: var(--color-primary);
  color: var(--color-text-inverse);
}

/* ============ 术语词汇 ============ */
.glossary-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.glossary-card {
  background: var(--color-bg-card);
  border-radius: 24rpx;
  padding: 28rpx;
  border: 1rpx solid var(--color-border-light);
  box-shadow: 0 2rpx 6rpx rgba(29, 31, 51, 0.04);
}

.glossary-term {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-ink);
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--color-border-light);
}

.glossary-def {
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--color-text-body);
  margin-bottom: 20rpx;
}

.glossary-def rich-text {
  display: block;
}

.glossary-example {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 20rpx;
  background: var(--color-student-pale);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.ex-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.ex-text {
  font-size: 26rpx;
  color: var(--color-text-body);
  line-height: 1.6;
}

.glossary-related {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.rel-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-muted);
}

.rel-tag {
  display: inline-flex;
  padding: 8rpx 20rpx;
  background: var(--color-primary-pale);
  color: var(--color-primary-deep);
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 500;
}

/* ============ 浮动辅导按钮 ============ */
.fab-btn {
  position: fixed;
  right: 32rpx;
  bottom: 120rpx;
  width: 104rpx;
  height: 104rpx;
  background: var(--color-primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(43, 45, 66, 0.3);
  z-index: 99;
  transition: all 0.15s;
}

.fab-btn:active {
  transform: scale(0.92);
  background: var(--color-primary-deep);
}

.fab-icon {
  font-size: 44rpx;
}

/* ============ 辅导浮窗 ============ */
.float-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.float-panel {
  width: 100%;
  height: 85vh;
  background: var(--color-bg-card);
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.float-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  background: var(--color-primary);
}

.float-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-inverse);
}

.float-close {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 50%;
  font-size: 28rpx;
  color: var(--color-text-inverse);
}

.float-close:active {
  background: rgba(255, 255, 255, 0.3);
}

.float-chat {
  flex: 1;
  padding: 24rpx 32rpx;
  background: var(--color-bg-page);
}

.float-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.float-row.is-user {
  flex-direction: row-reverse;
}

.float-avatar {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-card);
  border-radius: 50%;
  font-size: 32rpx;
  flex-shrink: 0;
}

.float-bubble {
  max-width: 70%;
  padding: 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.float-bubble.ai {
  background: var(--color-bg-card);
  color: var(--color-text-body);
  border: 1rpx solid var(--color-border-light);
  border-top-left-radius: 8rpx;
}

.float-bubble.user {
  background: var(--color-primary);
  color: var(--color-text-inverse);
  border-top-right-radius: 8rpx;
}

.float-bubble rich-text {
  display: block;
}

.float-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  background: var(--color-bg-card);
  border-top: 1rpx solid var(--color-border-light);
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.float-input {
  flex: 1;
  height: 80rpx;
  background: var(--color-bg-page-2);
  border: 1rpx solid var(--color-border-light);
  border-radius: 40rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: var(--color-text-body);
}

.float-send {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  padding: 0 32rpx;
  background: var(--color-student);
  color: var(--color-text-inverse);
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.float-send:active {
  background: #964527;
}

/* ============ 安全区 ============ */
.safe-bottom {
  height: env(safe-area-inset-bottom);
  min-height: 40rpx;
}
