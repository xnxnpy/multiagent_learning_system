.resource-container {
  min-height: 100vh;
  background: #f5f7fa;
}

/* 顶部操作栏 */
.action-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.action-left {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 68rpx;
  border-radius: 34rpx;
  font-size: 26rpx;
  padding: 0 28rpx;
}

.action-btn.primary {
  background: linear-gradient(135deg, #4F46E5 0%, #6366F1 100%);
  color: #fff;
}

.action-btn.secondary {
  background: #fff;
  color: #374151;
  border: 1rpx solid #E5E7EB;
}

.btn-icon {
  font-size: 28rpx;
}

.action-right {
  flex-shrink: 0;
}

.topic-tag {
  font-size: 22rpx;
  color: #6B7280;
  background: #F3F4F6;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

/* Tab 操作栏 */
.tab-action-bar {
  display: flex;
  justify-content: flex-end;
  padding: 12rpx 0;
  margin-bottom: 8rpx;
}

.regen-btn {
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  padding: 0 24rpx;
  border-radius: 28rpx;
  background: #FEF3C7;
  color: #D97706;
  border: 1rpx solid #FCD34D;
  text-align: center;
}

.regen-btn:active {
  background: #FDE68A;
}

.main-content {
  height: calc(100vh - 100rpx);
  overflow-y: auto;
}

.canvas-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(22, 119, 255, 0.08);
  overflow: hidden;
}

.canvas-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  position: relative;
  z-index: 10;
  background: #fff;
}

.toolbar-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.toolbar-btn {
  background: #1677ff;
  color: #fff;
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
}

.touch-canvas {
  display: block;
  width: 100%;
}

.canvas-scroll {
  flex: 1;
  width: 100%;
}

.canvas-overlay {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: #fff;
  margin: 16rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(22, 119, 255, 0.08);
  height: calc(100vh - 100rpx);
}

.overlay-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.overlay-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.overlay-btn {
  background: #1677ff;
  color: #fff;
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
}

.full-canvas {
  flex: 1;
  width: 100%;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 30rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  margin-bottom: 40rpx;
}

.primary-btn {
  padding: 20rpx 60rpx;
  font-size: 28rpx;
  background: #4F46E5;
  color: #fff;
  border: none;
  border-radius: 8rpx;
}

.resource-content {
  padding: 20rpx;
}

.agent-status-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx;
  background: #f0f0ff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  font-size: 26rpx;
  color: #4F46E5;
}

.spinner {
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid #4F46E5;
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.recommend-card {
  display: flex;
  gap: 16rpx;
  padding: 20rpx;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #e8e8e8;
}

.recommend-icon {
  font-size: 36rpx;
}

.recommend-info {
  flex: 1;
}

.recommend-title {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.recommend-desc {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.tabs-scroll {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.tabs {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx;
}

.tab-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
  border: 1rpx solid #e8e8e8;
}

.tab-item.active {
  background: #4F46E5;
  border-color: #4F46E5;
}

.tab-icon {
  font-size: 32rpx;
  margin-bottom: 8rpx;
}

.tab-name {
  font-size: 24rpx;
  color: #333;
}

.tab-item.active .tab-name {
  color: #fff;
}

.tab-content {
  min-height: 400rpx;
}

.resource-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.card-header {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.card-icon {
  font-size: 40rpx;
}

.card-info {
  flex: 1;
}

.card-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.card-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.card-body {
  margin-bottom: 20rpx;
}

.preview-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  background: #f5f7fa;
  color: #666;
  border-radius: 6rpx;
}

.read-btn, .play-btn, .practice-btn, .run-btn {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
}

.read-btn {
  background: #4F46E5;
  color: #fff;
  border: none;
}

.play-btn {
  background: #faad14;
  color: #fff;
  border: none;
}

.practice-btn {
  background: #52c41a;
  color: #fff;
  border: none;
}

.run-btn {
  background: #1890ff;
  color: #fff;
  border: none;
}

.video-card {
  padding: 0;
}

.video-placeholder {
  position: relative;
  height: 300rpx;
  background: #1a1a1a;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx 16rpx 0 0;
}

.play-icon {
  width: 80rpx;
  height: 80rpx;
  background: rgba(255,255,255,0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #4F46E5;
  margin-bottom: 16rpx;
}

.video-title {
  font-size: 28rpx;
  color: #fff;
  margin-bottom: 8rpx;
}

.video-duration {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}

.video-card .card-info {
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.video-card .card-footer {
  padding: 16rpx 24rpx;
}

.video-player-wrap {
  width: 100%;
}

.video-player {
  width: 100%;
  height: 400rpx;
}

.video-hint {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.mindmap-inline {
  padding: 16rpx 24rpx;
  background: #fafbfc;
  border-radius: 12rpx;
  margin: 12rpx 0;
}

.mindmap-inline rich-text {
  font-size: 26rpx;
  line-height: 1.6;
  color: #374151;
}

.mindmap-tree-wrap {
  padding: 16rpx;
  background: #fafbfc;
  border-radius: 12rpx;
  margin: 12rpx 0;
  border: 1rpx solid #e2e8f0;
}

.mindmap-tree-wrap rich-text {
  display: block;
}

.mindmap-img-wrap {
  padding: 12rpx;
  background: #fff;
  border-radius: 12rpx;
  margin: 12rpx 0;
  border: 1rpx solid #e2e8f0;
  text-align: center;
}

.mindmap-img {
  width: 100%;
  display: block;
  border-radius: 8rpx;
}

.mindmap-loading {
  padding: 40rpx;
  text-align: center;
  color: #999;
  font-size: 26rpx;
  background: #fafbfc;
  border-radius: 12rpx;
  margin: 12rpx 0;
  border: 1rpx solid #e2e8f0;
}

.mindmap-tip {
  text-align: center;
  padding-top: 12rpx;
  border-top: 1rpx dashed #93c5fd;
  margin-top: 12rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #3b82f6;
}

.mindmap-preview {
  margin-bottom: 20rpx;
}

.mindmap-placeholder, .kg-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  border: 2rpx dashed #d9d9d9;
}

.kg-img-wrap {
  padding: 12rpx;
  background: #fff;
  border-radius: 12rpx;
  margin: 12rpx 0;
  border: 1rpx solid #e2e8f0;
}

.kg-img {
  width: 100%;
  display: block;
  border-radius: 8rpx;
}

.kg-loading {
  padding: 40rpx;
  text-align: center;
  color: #999;
  font-size: 26rpx;
  background: #fafbfc;
  border-radius: 12rpx;
  margin: 12rpx 0;
  border: 1rpx solid #e2e8f0;
}

.kg-canvas-wrap {
  margin: 12rpx 0;
  background: #fafbfc;
  border-radius: 12rpx;
  border: 1rpx solid #e2e8f0;
  overflow: hidden;
}

.kg-canvas {
  width: 100%;
  height: 500rpx;
}

.placeholder-icon {
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.placeholder-text {
  font-size: 26rpx;
  color: #999;
}

.view-btn {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
  background: #4F46E5;
  color: #fff;
  border: none;
}

.question-content {
  margin-bottom: 20rpx;
}

.question-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 16rpx;
  display: block;
}

.options-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #f5f7fa;
  border-radius: 10rpx;
  margin-bottom: 12rpx;
  border: 2rpx solid transparent;
}

.option-item.selected {
  background: #f0f0ff;
  border-color: #4F46E5;
}

.option-radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #d9d9d9;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  font-size: 24rpx;
  color: #4F46E5;
  background: #fff;
}

.option-item.selected .option-radio {
  background: #4F46E5;
  border-color: #4F46E5;
  color: #fff;
}

.option-label {
  font-size: 26rpx;
  color: #333;
}

.option-item.selected .option-label {
  color: #4F46E5;
}

.code-card {
  padding: 24rpx;
}

.code-info {
  margin-bottom: 16rpx;
}

.info-row {
  display: flex;
  margin-bottom: 12rpx;
}

.info-label {
  font-size: 24rpx;
  color: #999;
  width: 120rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 24rpx;
  color: #333;
}

.info-value.code-text {
  font-family: monospace;
  color: #4F46E5;
}

.code-block {
  padding: 16rpx;
  background: #1a1a1a;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  overflow-x: auto;
}

.code-text {
  font-size: 22rpx;
  color: #e0e0e0;
  font-family: monospace;
  white-space: pre-wrap;
  line-height: 1.6;
}

.glossary-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.glossary-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.glossary-term {
  font-size: 30rpx;
  font-weight: bold;
  color: #4F46E5;
  margin-bottom: 12rpx;
  display: block;
}

.glossary-def {
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 12rpx;
  display: block;
}

.glossary-example {
  display: flex;
  gap: 8rpx;
  padding: 12rpx;
  background: #f5f7fa;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.example-icon {
  font-size: 24rpx;
}

.glossary-example text:last-child {
  font-size: 24rpx;
  color: #666;
}

.glossary-related {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.related-label {
  font-size: 24rpx;
  color: #999;
}

.related-tag {
  font-size: 22rpx;
  padding: 6rpx 12rpx;
  background: #e6f4ff;
  color: #1677ff;
  border-radius: 6rpx;
}

.knowledge-link-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.link-summary {
  display: flex;
  gap: 30rpx;
  margin-bottom: 20rpx;
}

.answer-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.card-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.card-cell {
  width: 72rpx;
  height: 72rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid transparent;
}

.card-cell:active {
  background: #e8e8ff;
  border-color: #4F46E5;
  color: #4F46E5;
}

.card-stats {
  margin-bottom: 20rpx;
}

.stat-total {
  font-size: 26rpx;
  color: #999;
}

.card-actions {
  display: flex;
  justify-content: flex-end;
}

.view-toggle {
  display: flex;
  background: #f5f7fa;
  border-radius: 8rpx;
  padding: 6rpx;
}

.toggle-item {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: #666;
  border-radius: 6rpx;
}

.toggle-item.active {
  background: #4F46E5;
  color: #fff;
}

.question-panel {
  margin-bottom: 20rpx;
}

.question-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.nav-btn {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  background: #f5f7fa;
  color: #666;
  border-radius: 8rpx;
  border: none;
}

.nav-indicator {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.question-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.debug-info {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
  display: block;
}

.question-card-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.question-num {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.question-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
}

.question-tag.success {
  background: #f6ffed;
  color: #52c41a;
}

.question-tag.warning {
  background: #fffbe6;
  color: #faad14;
}

.question-tag.danger {
  background: #fff2f0;
  color: #ff4d4f;
}

.question-tag.info {
  background: #e6f7ff;
  color: #1890ff;
}

.question-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 24rpx;
  display: block;
}

.question-body {
  margin-bottom: 24rpx;
}

.question-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
}

.option-item.selected {
  background: #f0f0ff;
  border-color: #4F46E5;
}

.option-radio {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #d9d9d9;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  font-size: 24rpx;
  color: #4F46E5;
  background: #fff;
}

.option-item.selected .option-radio {
  background: #4F46E5;
  border-color: #4F46E5;
  color: #fff;
}

.option-label {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.option-item.selected .option-label {
  color: #4F46E5;
}

.answer-input {
  width: 100%;
  padding: 20rpx;
  font-size: 28rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  border: 2rpx solid #e8e8e8;
}

.answer-textarea {
  width: 100%;
  height: 200rpx;
  padding: 20rpx;
  font-size: 26rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  border: 2rpx solid #e8e8e8;
  font-family: monospace;
}

.test-cases {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #f5f7fa;
  border-radius: 8rpx;
}

.test-cases-title {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
  display: block;
}

.test-case {
  font-size: 24rpx;
  color: #666;
  font-family: monospace;
  display: block;
  margin-bottom: 8rpx;
}

.submit-btn {
  width: 100%;
  padding: 24rpx;
  font-size: 30rpx;
  background: #4F46E5;
  color: #fff;
  border-radius: 12rpx;
  border: none;
  margin-bottom: 20rpx;
}

.answer-feedback {
  padding: 16rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.feedback-text.correct {
  color: #52c41a;
  font-size: 26rpx;
}

.feedback-text.wrong {
  color: #ff4d4f;
  font-size: 26rpx;
}

.summary-item {
  font-size: 24rpx;
  color: #666;
}

.link-nodes {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.link-node {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: #f5f7fa;
  border-radius: 20rpx;
}

.link-node .node-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.link-node .node-label {
  font-size: 24rpx;
  color: #333;
}

.empty-content {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 26rpx;
}

.markdown-body {
  line-height: 1.8;
  font-size: 28rpx;
