<view class="login-container">
  <view class="bg-decoration"></view>

  <view class="login-card">
    <view class="card-header">
      <text class="card-title">账号登录</text>
      <text class="card-subtitle">欢迎使用AI学习系统</text>
    </view>

    <view class="form-content">
      <view class="input-group">
        <text class="input-icon">👤</text>
        <input class="input" placeholder="请输入账号" value="{{username}}" bindinput="onUsernameInput"/>
      </view>
      <view class="input-group">
        <text class="input-icon">🔒</text>
        <input class="input" type="password" placeholder="请输入密码" value="{{password}}" bindinput="onPasswordInput"/>
      </view>

      <view class="form-options">
        <view class="checkbox-wrap" bindtap="toggleRemember">
          <view class="checkbox {{rememberMe ? 'checked' : ''}}"></view>
          <text class="option-text">记住账号</text>
        </view>
        <text class="forgot" bindtap="forgotPassword">忘记密码？</text>
      </view>

      <button class="login-btn" bindtap="login">登 录</button>

      <view class="register-link">
        <text class="link-text">还没有账号？</text>
        <text class="register" bindtap="goToRegister">立即注册</text>
      </view>
    </view>
  </view>

  <view class="footer">
    <text>© 2024 AI Learning System</text>
  </view>
</view>
