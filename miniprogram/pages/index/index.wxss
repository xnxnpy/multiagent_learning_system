.login-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #e6f0ff 0%, #f0f5ff 50%, #ffffff 100%);
  padding: 60rpx 40rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.bg-decoration {
  position: absolute;
  top: -200rpx;
  left: -100rpx;
  width: 600rpx;
  height: 600rpx;
  background: radial-gradient(circle, rgba(22, 119, 255, 0.15) 0%, transparent 70%);
  border-radius: 50%;
}

.bg-decoration::after {
  content: '';
  position: absolute;
  bottom: -100rpx;
  right: -100rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(64, 150, 255, 0.1) 0%, transparent 70%);
  border-radius: 50%;
}

.login-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(22, 119, 255, 0.15);
  position: relative;
  z-index: 1;
}

.card-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.card-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #1677ff;
  margin-bottom: 10rpx;
}

.card-subtitle {
  display: block;
  font-size: 26rpx;
  color: #999;
}

.form-content {
  display: flex;
  flex-direction: column;
}

.input-group {
  display: flex;
  align-items: center;
  background: #f5f7fa;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  padding: 0 30rpx;
  margin-bottom: 25rpx;
  transition: all 0.3s;
}

.input-group:focus-within {
  border-color: #1677ff;
  background: #ffffff;
}

.input-icon {
  font-size: 32rpx;
  margin-right: 20rpx;
  color: #999;
}

.input {
  flex: 1;
  height: 90rpx;
  font-size: 28rpx;
  color: #333;
}

.form-options {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.checkbox-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #d9d9d9;
  border-radius: 6rpx;
  position: relative;
}

.checkbox.checked {
  background: #1677ff;
  border-color: #1677ff;
}

.checkbox.checked::after {
  content: '✓';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: #fff;
  font-size: 24rpx;
}

.option-text {
  font-size: 26rpx;
  color: #666;
}

.forgot {
  font-size: 26rpx;
  color: #1677ff;
}

.login-btn {
  width: 100%;
  height: 90rpx;
  background: linear-gradient(135deg, #1677ff 0%, #4096ff 100%);
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(22, 119, 255, 0.3);
}

.login-btn:active {
  transform: scale(0.98);
}



.register-link {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10rpx;
}

.link-text {
  font-size: 26rpx;
  color: #666;
}

.register {
  font-size: 26rpx;
  color: #1677ff;
  font-weight: 500;
}

.footer {
  text-align: center;
  margin-top: 60rpx;
}

.footer text {
  font-size: 24rpx;
  color: #999;
}
