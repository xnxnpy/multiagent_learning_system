.mindmap-page {
  min-height: 100vh;
  background: #fff;
  display: flex;
  flex-direction: column;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #E5E7EB;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.back-btn {
  font-size: 28rpx;
  color: #374151;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
}

.header-right {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  width: 60rpx;
  height: 60rpx;
  background: #F3F4F6;
  color: #374151;
  border-radius: 50%;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.scroll-area {
  flex: 1;
  background: #F9FAFB;
  padding: 20rpx;
}

.mindmap-wrapper {
  transform-origin: top left;
}

.mindmap-tree {
  position: relative;
  border: 1rpx dashed #E5E7EB;
}

.connection-line {
  position: absolute;
  height: 3px;
  transform-origin: left center;
  pointer-events: none;
}

.node-item {
  position: absolute;
  width: 160px;
  height: 40px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  z-index: 10;
}

.node-text {
  color: #fff;
  font-size: 13px;
  font-weight: 500;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  padding: 0 12px;
}

.footer {
  padding: 20rpx 30rpx;
  background: #fff;
  text-align: center;
}

.footer-text {
  font-size: 24rpx;
  color: #9CA3AF;
}