.path-container {
  min-height: 100vh;
  background: #f5f7fa;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.page-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a1a2e;
}

.header-right {
  display: flex;
  gap: 12rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
}

.action-btn.primary {
  background: linear-gradient(135deg, #4F46E5 0%, #6366F1 100%);
  color: #fff;
}

.action-btn.secondary {
  background: #fff;
  color: #374151;
  border: 1rpx solid #E5E7EB;
}

.main-content {
  height: calc(100vh - 100rpx);
  padding: 16rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 30rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  margin-bottom: 40rpx;
}

.primary-btn {
  padding: 20rpx 60rpx;
  font-size: 28rpx;
  background: #4F46E5;
  color: #fff;
  border: none;
  border-radius: 8rpx;
}

.path-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.path-card, .stage-card, .timeline-card, .kg-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.progress-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-weight: 500;
}

.progress-tag.primary {
  background: #EEF2FF;
  color: #4F46E5;
}

.progress-tag.success {
  background: #D1FAE5;
  color: #059669;
}

.steps-overview {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.step-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.step-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #D1D5DB;
}

.step-dot.completed {
  background: #10B981;
}

.step-dot.current {
  background: #4F46E5;
}

.step-title {
  font-size: 24rpx;
  color: #374151;
  font-weight: 500;
}

.step-desc {
  font-size: 22rpx;
  color: #9CA3AF;
}

.step-line {
  width: 32rpx;
  height: 4rpx;
  background: #E5E7EB;
}

.stage-actions {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
}

.action-btn.primary {
  background: linear-gradient(135deg, #4F46E5 0%, #6366F1 100%);
  color: #fff;
}

.action-btn.secondary {
  background: #fff;
  color: #374151;
  border: 1rpx solid #E5E7EB;
}

.action-btn.warning {
  background: #FEF3C7;
  color: #D97706;
  border: 1rpx solid #FCD34D;
}

.action-btn.success {
  background: #D1FAE5;
  color: #059669;
  border: 1rpx solid #A7F3D0;
}

.regen-btn {
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  padding: 0 24rpx;
  border-radius: 28rpx;
  background: #FEF3C7;
  color: #D97706;
  border: 1rpx solid #FCD34D;
  text-align: center;
}

.action-btn.small {
  padding: 8rpx 16rpx;
  font-size: 22rpx;
}

.action-btn.primary {
  background: #4F46E5;
  color: #fff;
  border: none;
}

.action-btn.warning {
  background: #fff;
  color: #faad14;
  border: 1rpx solid #faad14;
}

.action-btn.success {
  background: #fff;
  color: #52c41a;
  border: 1rpx solid #52c41a;
}

.stage-descriptions {
  margin-bottom: 20rpx;
}

.desc-row {
  display: flex;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.desc-label {
  font-size: 26rpx;
  color: #999;
  width: 160rpx;
  flex-shrink: 0;
}

.desc-value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}

.kp-section, .rt-section {
  margin-bottom: 20rpx;
}

.section-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 12rpx;
  display: block;
}

.kp-tags, .rt-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.kp-tag {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  background: #e6f4ff;
  color: #1677ff;
  border-radius: 6rpx;
}

.rt-tag {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  background: #fff7e6;
  color: #fa8c16;
  border-radius: 6rpx;
}

.generating-tip, .loading-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 30rpx;
  background: #f0f0ff;
  border-radius: 10rpx;
  margin-top: 20rpx;
}

.generating-icon, .loading-icon {
  font-size: 32rpx;
}

.kg-content {
  margin-top: 20rpx;
}

.kg-img-wrap {
  margin-top: 16rpx;
  background: #fff;
  border-radius: 12rpx;
  border: 1rpx solid #e2e8f0;
  overflow: hidden;
}

.kg-img {
  width: 100%;
  display: block;
}

.kg-rendering {
  padding: 40rpx;
  text-align: center;
  color: #999;
  font-size: 26rpx;
  background: #fafbfc;
  border-radius: 12rpx;
  border: 1rpx solid #e2e8f0;
  margin-top: 16rpx;
}

.kg-summary {
  display: flex;
  gap: 30rpx;
  margin-bottom: 20rpx;
}

.summary-item {
  font-size: 26rpx;
  color: #666;
}

.kg-nodes {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.kg-node {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: #f5f7fa;
  border-radius: 20rpx;
}

.node-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.node-label {
  font-size: 24rpx;
  color: #333;
}

.kg-loading, .stage-generating {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 30rpx;
  justify-content: center;
  color: #666;
  font-size: 26rpx;
}

.kg-empty {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}

.timeline-list {
  position: relative;
}

.timeline-item {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.timeline-item:last-child {
  margin-bottom: 0;
}

.timeline-item.clickable {
  cursor: pointer;
}

.timeline-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 40rpx;
  flex-shrink: 0;
}

.timeline-node .node-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #d9d9d9;
  border: 4rpx solid #fff;
  box-shadow: 0 0 0 4rpx #d9d9d9;
}

.timeline-node .node-dot.completed {
  background: #52c41a;
  box-shadow: 0 0 0 4rpx #d9f7be;
}

.timeline-node .node-dot.current {
  background: #4F46E5;
  box-shadow: 0 0 0 4rpx #e6f4ff;
}

.timeline-node .node-dot.hollow {
  background: transparent;
  border: 4rpx solid #d9d9d9;
  box-shadow: none;
}

.node-line {
  width: 4rpx;
  flex: 1;
  background: #e8e8e8;
  margin-top: 10rpx;
}

.timeline-item.completed .node-line {
  background: #52c41a;
}

.timeline-item.current .node-line {
  background: #4F46E5;
}

.timeline-content {
  flex: 1;
  padding-bottom: 10rpx;
}

.stage-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.stage-number {
  font-size: 24rpx;
  color: #4F46E5;
  font-weight: 500;
}

.status-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: #f5f5f5;
  color: #999;
}

.status-tag.completed {
  background: #d9f7be;
  color: #52c41a;
}

.status-tag.current {
  background: #e6f4ff;
  color: #1677ff;
}

.review-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: #f5f5f5;
  color: #999;
}

.stage-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.stage-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 15rpx;
  line-height: 1.5;
}

.timeline-kps {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.kps-tag {
  font-size: 22rpx;
  padding: 6rpx 12rpx;
  background: #f5f7fa;
  color: #666;
  border-radius: 6rpx;
}

.recommendation-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.section-header {
  margin-bottom: 20rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.section-subtitle {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.recommend-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.recommend-card {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #f9fafb;
  border-radius: 12rpx;
}

.card-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.card-info {
  flex: 1;
}

.card-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.card-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.card-action {
  margin-left: 10rpx;
}

.arrow {
  font-size: 28rpx;
  color: #ccc;
}

/* 浮动辅导助手按钮 */
.float-btn {
  position: fixed;
  right: 30rpx;
  bottom: 120rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6366F1, #4F46E5);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(99, 102, 241, 0.4);
  z-index: 100;
}

.float-icon { font-size: 40rpx; color: #fff; }

/* 辅导浮窗 */
.float-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4); z-index: 200;
  display: flex; align-items: flex-end; justify-content: flex-end; padding: 20rpx;
}

.float-panel {
  width: 600rpx; height: 800rpx; background: #fff; border-radius: 24rpx;
  display: flex; flex-direction: column; overflow: hidden;
  box-shadow: 0 12rpx 40rpx rgba(0,0,0,0.15);
}

.float-header {
  display: flex; justify-content: space-between; align-items: center;
  padding: 20rpx 24rpx; background: linear-gradient(135deg, #6366F1, #4F46E5); color: #fff;
}
.float-title { font-size: 28rpx; font-weight: 600; }
.float-close { font-size: 32rpx; padding: 8rpx; }

.float-chat-box { flex: 1; padding: 16rpx; overflow-y: auto; }

.float-msg { display: flex; margin-bottom: 20rpx; align-items: flex-start; }
.float-msg.right { flex-direction: row-reverse; }

.float-avatar {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: linear-gradient(135deg, #4F46E5, #6366F1);
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; flex-shrink: 0; color: #fff;
}
.float-avatar.user { background: #E0E7FF; }

.float-bubble { max-width: 70%; padding: 16rpx 20rpx; border-radius: 16rpx; font-size: 26rpx; line-height: 1.6; }
.float-bubble.ai { background: #F3F4F6; border-top-left-radius: 4rpx; }
.float-bubble.user { background: linear-gradient(135deg, #4F46E5, #6366F1); color: #fff; border-top-right-radius: 4rpx; }

.float-input-area {
  display: flex; gap: 12rpx; padding: 16rpx; border-top: 1rpx solid #f0f0f0; background: #fff;
}
.float-input { flex: 1; height: 68rpx; background: #F3F4F6; border-radius: 34rpx; padding: 0 24rpx; font-size: 26rpx; }
.float-send {
  width: 100rpx; height: 68rpx; background: linear-gradient(135deg, #4F46E5, #6366F1);
  color: #fff; border-radius: 34rpx; display: flex; align-items: center; justify-content: center; font-size: 26rpx;
}