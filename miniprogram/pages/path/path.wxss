/* ============================================================
 * 学习路径页 — 小程序样式
 * 暖学术风格：墨蓝主色 + 陶土橙辅色 + 象牙纸背景
 * ============================================================ */

.path-container {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: 180rpx;
}

/* ── 顶部导航栏 ── */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background: var(--color-bg-card);
  border-bottom: 1rpx solid var(--color-border-light);
  position: sticky;
  top: 0;
  z-index: 10;
}

.page-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text-ink);
  letter-spacing: -0.02em;
}

.header-right {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
  height: 68rpx;
  padding: 0 16rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 500;
  transition: all 0.15s;
  line-height: 1;
  box-sizing: border-box;
}

.action-btn.primary {
  background: var(--color-student);
  color: var(--color-text-inverse);
  box-shadow: 0 3rpx 10rpx rgba(176, 81, 44, 0.18);
  font-weight: 600;
}

.action-btn.primary:active {
  background: #964527;
  transform: translateY(-1rpx);
  box-shadow: 0 5rpx 14rpx rgba(176, 81, 44, 0.24);
}

.action-btn.secondary {
  background: var(--color-bg-card);
  color: var(--color-text-body);
  border: 1rpx solid var(--color-border-light);
}

.action-btn.secondary:active {
  border-color: var(--color-primary);
  background: var(--color-primary-faint);
  color: var(--color-primary-deep);
}

.action-btn.warning {
  background: var(--color-warning-soft);
  color: var(--color-warning);
  border: 1rpx solid var(--color-warning-pale);
}

.action-btn.warning:active {
  background: var(--color-warning-pale);
  opacity: 0.95;
}

.action-btn.success {
  background: var(--color-success-soft);
  color: var(--color-success);
  border: 1rpx solid var(--color-success-pale);
}

.action-btn.success:active {
  background: var(--color-success-pale);
  opacity: 0.95;
}

/* ── 主内容区 ── */
.main-content {
  padding: 24rpx;
  box-sizing: border-box;
}

/* ── 空状态 ── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
  text-align: center;
}

.empty-icon {
  font-size: 88rpx;
  margin-bottom: 28rpx;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: var(--color-bg-page-2);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.85;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-ink);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--color-text-muted);
  line-height: 1.75;
  padding: 0 40rpx;
  margin-bottom: 40rpx;
}

.primary-btn {
  padding: 22rpx 56rpx;
  background: var(--color-student);
  color: var(--color-text-inverse);
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(176, 81, 44, 0.25);
  border: none;
}

.primary-btn:active {
  background: #964527;
}

/* ── 卡片通用 ── */
.path-card,
.stage-card,
.kg-card,
.timeline-card,
.recommendation-section {
  background: var(--color-bg-card);
  border-radius: 28rpx;
  border: 1rpx solid var(--color-border-light);
  box-shadow: 0 2rpx 8rpx rgba(29, 31, 51, 0.04);
  margin-bottom: 24rpx;
  overflow: hidden;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx 20rpx;
  border-bottom: 1rpx solid var(--color-border-light);
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-ink);
  letter-spacing: -0.02em;
}

/* ── 路径概览卡 ── */
.path-card {
  position: relative;
}

.path-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 8rpx;
  height: 100%;
  background: var(--color-student);
}

.progress-tag {
  padding: 8rpx 20rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.02em;
}

.progress-tag.primary {
  background: var(--color-student-pale);
  color: var(--color-student);
}

.progress-tag.success {
  background: var(--color-success-soft);
  color: var(--color-success);
}

.progress-tag.info {
  background: var(--color-primary-pale);
  color: var(--color-primary-deep);
}

.steps-overview {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 28rpx 28rpx;
  overflow-x: auto;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 120rpx;
  position: relative;
  flex-shrink: 0;
}

.step-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 3rpx solid var(--color-border);
  background: var(--color-bg-card);
  margin-bottom: 12rpx;
  position: relative;
  z-index: 2;
}

.step-dot.completed {
  background: var(--color-success);
  border-color: var(--color-success);
}

.step-dot.current {
  background: var(--color-student);
  border-color: var(--color-student);
  box-shadow: 0 0 0 6rpx var(--color-student-pale);
}

.step-dot.pending {
  background: var(--color-bg-card);
  border-color: var(--color-border);
}

.step-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-ink);
  text-align: center;
  line-height: 1.4;
  margin-bottom: 4rpx;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.step-desc {
  font-size: 20rpx;
  color: var(--color-text-muted);
  text-align: center;
}

.step-line {
  position: absolute;
  top: 12rpx;
  left: calc(50% + 12rpx);
  width: calc(100% - 24rpx);
  height: 4rpx;
  background: var(--color-border-light);
  z-index: 1;
}

/* ── 当前阶段卡 ── */
.stage-card {
  background: linear-gradient(180deg, #FFFFFF 0%, var(--color-student-pale) 100%);
}

.stage-card .card-header {
  background: transparent;
  border-bottom: none;
}

.stage-actions {
  display: flex;
  gap: 12rpx;
  flex-wrap: nowrap;
  padding: 0 28rpx 20rpx;
}

.stage-descriptions {
  padding: 0 28rpx 20rpx;
}

.desc-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.desc-label {
  font-size: 24rpx;
  color: var(--color-text-muted);
  font-weight: 500;
  flex-shrink: 0;
  width: 140rpx;
}

.desc-value {
  font-size: 26rpx;
  color: var(--color-text-body);
  line-height: 1.6;
  flex: 1;
}

.kp-section,
.rt-section {
  padding: 16rpx 28rpx;
}

.section-label {
  font-size: 24rpx;
  color: var(--color-text-muted);
  font-weight: 500;
  display: block;
  margin-bottom: 12rpx;
}

.kp-tags,
.rt-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.kp-tag {
  padding: 8rpx 20rpx;
  background: var(--color-primary-pale);
  color: var(--color-primary-deep);
  font-size: 22rpx;
  border-radius: 10rpx;
  font-weight: 500;
}

.rt-tag {
  padding: 8rpx 20rpx;
  background: var(--color-student-pale);
  color: var(--color-student);
  font-size: 22rpx;
  border-radius: 10rpx;
  font-weight: 500;
}

.stage-generating {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  background: var(--color-warning-soft);
  color: var(--color-warning);
  font-size: 26rpx;
  font-weight: 500;
  margin: 0 28rpx 20rpx;
  border-radius: 16rpx;
}

.generating-icon {
  font-size: 32rpx;
}

/* ── 状态标签 ── */
.status-tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.status-tag.completed {
  background: var(--color-success-soft);
  color: var(--color-success);
}

.status-tag.current {
  background: var(--color-student-pale);
  color: var(--color-student);
}

.status-tag.pending {
  background: var(--color-bg-page-2);
  color: var(--color-text-muted);
}

.status-tag.success {
  background: var(--color-success-soft);
  color: var(--color-success);
}

.status-tag.primary {
  background: var(--color-student-pale);
  color: var(--color-student);
}

.status-tag.info {
  background: var(--color-primary-pale);
  color: var(--color-primary-deep);
}

/* ── 知识图谱卡 ── */
.kg-card {
  padding-bottom: 20rpx;
}

.regen-btn {
  font-size: 24rpx;
  color: var(--color-student);
  font-weight: 600;
}

.kg-loading,
.kg-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 48rpx 28rpx;
  color: var(--color-text-muted);
  font-size: 26rpx;
}

.loading-icon {
  font-size: 32rpx;
}

.kg-summary {
  display: flex;
  gap: 32rpx;
  padding: 20rpx 28rpx;
}

.summary-item {
  font-size: 26rpx;
  color: var(--color-text-body);
  font-weight: 500;
}

.kg-img-wrap {
  padding: 16rpx 28rpx;
}

.kg-img {
  width: 100%;
  border-radius: 16rpx;
  border: 1rpx solid var(--color-border-light);
}

.kg-rendering {
  padding: 32rpx 28rpx;
  text-align: center;
  color: var(--color-text-muted);
  font-size: 26rpx;
}

/* ── 时间轴/学习进度卡 ── */
.timeline-card {
  padding-bottom: 8rpx;
}

.timeline-list {
  padding: 12rpx 0;
}

.timeline-item {
  display: flex;
  padding: 16rpx 28rpx;
  position: relative;
  transition: background 0.15s;
}

.timeline-item.clickable {
  cursor: pointer;
}

.timeline-item.clickable:active {
  background: var(--color-bg-page-2);
}

.timeline-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 48rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.node-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 3rpx solid var(--color-border);
  background: var(--color-bg-card);
  flex-shrink: 0;
  z-index: 2;
}

.node-dot.completed {
  background: var(--color-success);
  border-color: var(--color-success);
}

.node-dot.current {
  background: var(--color-student);
  border-color: var(--color-student);
  box-shadow: 0 0 0 6rpx var(--color-student-pale);
}

.node-dot.hollow {
  background: var(--color-bg-card);
  border-color: var(--color-border);
}

.node-line {
  width: 4rpx;
  flex: 1;
  min-height: 48rpx;
  background: var(--color-border-light);
  margin: 4rpx 0;
}

.timeline-content {
  flex: 1;
  padding-bottom: 12rpx;
}

.stage-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
  flex-wrap: wrap;
}

.stage-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-ink);
  letter-spacing: -0.01em;
}

.stage-title.font-bold {
  color: var(--color-student);
  font-weight: 700;
}

.review-tag {
  padding: 4rpx 12rpx;
  background: var(--color-primary-pale);
  color: var(--color-primary-deep);
  font-size: 20rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.stage-desc {
  font-size: 24rpx;
  color: var(--color-text-muted);
  line-height: 1.5;
  margin-bottom: 10rpx;
}

.timeline-kps {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.kps-tag {
  padding: 4rpx 14rpx;
  background: var(--color-bg-page-2);
  color: var(--color-text-muted);
  font-size: 20rpx;
  border-radius: 8rpx;
}

/* ── 推荐区域 ── */
.recommendation-section {
  background: var(--color-bg-card);
}

.section-header {
  padding: 24rpx 28rpx 16rpx;
  border-bottom: 1rpx solid var(--color-border-light);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-ink);
  display: block;
  letter-spacing: -0.01em;
}

.section-subtitle {
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-top: 4rpx;
  display: block;
}

.recommend-list {
  padding: 4rpx 0;
}

.recommend-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 28rpx;
  transition: background 0.15s;
  border-bottom: 1rpx solid var(--color-border-light);
}

.recommend-card:last-child {
  border-bottom: none;
}

.recommend-card:active {
  background: var(--color-bg-page-2);
}

.card-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: var(--color-student-pale);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}

.card-info {
  flex: 1;
  min-width: 0;
}

.card-info .card-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-ink);
  margin-bottom: 4rpx;
  display: block;
  line-height: 1.4;
}

.card-desc {
  font-size: 22rpx;
  color: var(--color-text-muted);
  line-height: 1.5;
  display: block;
}

.card-action {
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.arrow {
  font-size: 26rpx;
  color: var(--color-text-faint);
}

/* ── 浮动辅导按钮 ── */
.float-btn {
  position: fixed;
  right: 32rpx;
  bottom: 200rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--color-student);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(176, 81, 44, 0.35);
  z-index: 100;
  transition: transform 0.2s;
}

.float-btn:active {
  transform: scale(0.92);
}

.float-icon {
  font-size: 44rpx;
}

/* ── 浮动辅导面板 ── */
.float-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(29, 31, 51, 0.5);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.float-panel {
  width: 100%;
  max-height: 80vh;
  background: var(--color-bg-card);
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.float-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--color-border-light);
}

.float-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-ink);
}

.float-close {
  font-size: 36rpx;
  color: var(--color-text-muted);
  padding: 8rpx;
}

.float-chat-box {
  flex: 1;
  padding: 24rpx;
  max-height: 60vh;
}

.float-msg {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
  gap: 16rpx;
}

.float-msg.right {
  flex-direction: row-reverse;
}

.float-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--color-primary-pale);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}

.float-avatar.user {
  background: var(--color-student-pale);
}

.float-bubble {
  max-width: 75%;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  line-height: 1.6;
  word-break: break-all;
}

.float-bubble.left {
  background: var(--color-bg-page-2);
  color: var(--color-text-body);
  border-top-left-radius: 6rpx;
}

.float-bubble.right {
  background: var(--color-student);
  color: var(--color-text-inverse);
  border-top-right-radius: 6rpx;
}

.float-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 28rpx;
  border-top: 1rpx solid var(--color-border-light);
  background: var(--color-bg-card);
}

.float-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: var(--color-bg-page-2);
  border-radius: 36rpx;
  font-size: 26rpx;
  color: var(--color-text-body);
}

.float-send {
  padding: 16rpx 32rpx;
  background: var(--color-student);
  color: var(--color-text-inverse);
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.float-send:active {
  background: #964527;
}

/* ── 浮动输入区容器 ── */
.float-input-area {
  border-top: 1rpx solid var(--color-border-light);
  background: var(--color-bg-card);
}

.float-tool-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 28rpx 8rpx;
}

/* ── 浮动工具栏按钮 ── */
.float-tool-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--color-bg-page-2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
  position: relative;
}

.float-tool-btn:active {
  background: var(--color-border);
}

.float-tool-btn.recording {
  background: var(--color-student);
  color: var(--color-text-inverse);
  flex-direction: column;
  gap: 0;
}

.float-tool-btn.recording .float-recording-time {
  font-size: 18rpx;
  position: absolute;
  bottom: -32rpx;
  left: 50%;
  transform: translateX(-50%);
  white-space: nowrap;
  color: var(--color-student);
  font-weight: 500;
}

.float-tool-btn.loading {
  background: var(--color-warning-soft);
  color: var(--color-warning);
}

.float-recording-time {
  font-size: 18rpx;
  color: var(--color-text-muted);
}

.float-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 28rpx 24rpx;
}

/* ── 浮动待发送图片 ── */
.float-pending-row {
  display: flex;
  padding: 16rpx 28rpx 0;
  background: var(--color-bg-card);
}

.float-pending-preview {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  overflow: hidden;
  border: 2rpx solid var(--color-student);
}

.float-pending-preview image {
  width: 100%;
  height: 100%;
}

.float-pending-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ── 浮动消息中的图片 ── */
.float-msg-image {
  width: 100%;
  max-width: 320rpx;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
}

.float-bubble.right .float-msg-image {
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}