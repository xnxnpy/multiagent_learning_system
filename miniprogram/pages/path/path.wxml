<view class="path-container">
  <view class="header">
    <text class="page-title">学习路径</text>
    <view class="header-right">
      <view class="action-btn primary" bindtap="handleGenerate">
        <text>⚡ 生成学习路径</text>
      </view>
      <view class="action-btn secondary" bindtap="handleRefresh">
        <text>🔄 刷新</text>
      </view>
    </view>
  </view>

  <scroll-view scroll-y class="main-content">
    <view wx:if="{{!hasPath}}" class="empty-state">
      <view class="empty-icon">📋</view>
      <text class="empty-title">暂无学习路径</text>
      <text class="empty-desc">请先完成学习画像，然后点击上方按钮生成专属学习路径</text>
      <button class="primary-btn" bindtap="goToProfile">生成学习路径</button>
    </view>

    <view wx:else class="path-content">
      <view class="path-card">
        <view class="card-header">
          <text class="card-title">{{pathTitle}}</text>
          <view class="progress-tag {{progressTagClass}}">
            {{progressTagText}}
          </view>
        </view>
        <view class="steps-overview">
          <view class="step-item" wx:for="{{stages}}" wx:key="id">
            <view class="step-dot {{item.statusClass}}"></view>
            <text class="step-title">{{item.title}}</text>
            <text class="step-desc">{{item.duration}}</text>
            <view class="step-line" wx:if="{{index < stages.length - 1}}"></view>
          </view>
        </view>
      </view>

      <view wx:if="{{currentStageData}}" class="stage-card">
        <view class="card-header">
          <text class="card-title">当前阶段：{{currentStageData.title}}</text>
          <view class="stage-actions">
            <view class="action-btn primary" bindtap="startStage" data-stage="{{currentStageData.id}}">▶ 开始学习</view>
            <view class="action-btn warning" wx:if="{{currentStageData.status !== 'completed'}}" bindtap="handleGenerateStageResources">✨ 生成资源</view>
            <view class="action-btn success" wx:if="{{currentStageData.status !== 'completed' && completedStages < totalStages}}" bindtap="handleCompleteStage">✓ 完成</view>
            <view class="status-tag completed" wx:if="{{currentStageData.status === 'completed'}}">已完成</view>
          </view>
        </view>
        <view class="stage-descriptions">
          <view class="desc-row">
            <text class="desc-label">阶段描述</text>
            <text class="desc-value">{{currentStageData.description || '暂无描述'}}</text>
          </view>
          <view class="desc-row">
            <text class="desc-label">预计时长</text>
            <text class="desc-value">{{currentStageData.duration}}</text>
          </view>
        </view>
        <view wx:if="{{currentStageData.knowledge_points && currentStageData.knowledge_points.length > 0}}" class="kp-section">
          <text class="section-label">知识点：</text>
          <view class="kp-tags">
            <text class="kp-tag" wx:for="{{currentStageData.knowledge_points}}" wx:key="index">{{item.name || item}}</text>
          </view>
        </view>
        <view wx:if="{{currentStageData.recommended_resource_types && currentStageData.recommended_resource_types.length > 0}}" class="rt-section">
          <text class="section-label">推荐资源类型：</text>
          <view class="rt-tags">
            <text class="rt-tag" wx:for="{{currentStageData.recommended_resource_types}}" wx:key="index">{{resourceText(item)}}</text>
          </view>
        </view>
        <view wx:if="{{stageGenerating}}" class="stage-generating">
          <text class="generating-icon">⏳</text>
          <text>正在生成本阶段学习资源，请稍候...</text>
        </view>
      </view>

      <view class="kg-card">
        <view class="card-header">
          <text class="card-title">知识图谱</text>
          <view class="regen-btn" bindtap="handleGenerateKnowledgeGraph">
            ✨ {{knowledgeGraphData ? '重新生成' : '生成知识图谱'}}
          </view>
        </view>
        <view wx:if="{{kgLoading}}" class="kg-loading">
          <text class="loading-icon">⏳</text>
          <text>正在生成知识图谱...</text>
        </view>
        <view wx:elif="{{knowledgeGraphData}}" class="kg-content">
          <view class="kg-summary">
            <text class="summary-item">知识点数量：{{knowledgeGraphData.nodes.length}}</text>
            <text class="summary-item">关联数量：{{knowledgeGraphData.edges ? knowledgeGraphData.edges.length : 0}}</text>
          </view>
          <view wx:if="{{kgImg}}" class="kg-img-wrap">
            <image src="{{kgImg}}" mode="widthFix" class="kg-img" />
          </view>
          <view wx:else class="kg-rendering">
            <text>知识图谱渲染中...</text>
          </view>
        </view>
        <view wx:else class="kg-empty">
          <text>暂无知识图谱，点击上方按钮生成</text>
        </view>
      </view>

      <view class="timeline-card">
        <view class="card-header">
          <text class="card-title">学习进度</text>
        </view>
        <view class="timeline-list">
          <view 
            class="timeline-item {{item.statusClass}} {{item.clickableClass}}"
            wx:for="{{stages}}" 
            wx:key="id"
            bindtap="handleStageClick"
            data-stage-id="{{item.id}}"
            data-index="{{index}}"
          >
            <view class="timeline-node">
              <view class="node-dot {{item.nodeClass}}"></view>
              <view class="node-line" wx:if="{{index < stages.length - 1}}"></view>
            </view>
            <view class="timeline-content">
              <view class="stage-header">
                <text class="stage-title {{item.status === 'current' ? 'font-bold' : ''}}">{{item.title}}</text>
                <view class="status-tag {{item.tagClass}}">
                  {{item.tagText}}
                </view>
                <view class="review-tag" wx:if="{{item.status === 'completed'}}">可复习</view>
              </view>
              <text class="stage-desc">{{item.description}}</text>
              <view wx:if="{{item.knowledge_points && item.knowledge_points.length > 0}}" class="timeline-kps">
                <text class="kps-tag" wx:for="{{item.knowledge_points}}" wx:key="index">{{item.name || item}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="recommendation-section">
        <view class="section-header">
          <text class="section-title">智能推荐</text>
          <text class="section-subtitle">根据您的学习情况推荐</text>
        </view>
        <view class="recommend-list">
          <view class="recommend-card" wx:for="{{recommendations}}" wx:key="id">
            <view class="card-icon">{{item.icon}}</view>
            <view class="card-info">
              <text class="card-title">{{item.title}}</text>
              <text class="card-desc">{{item.description}}</text>
            </view>
            <view class="card-action">
              <text class="arrow">→</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
  <canvas type="2d" id="pathKgCanvas" style="position:fixed;left:0;top:0;width:1px;height:1px;opacity:0;"></canvas>
  <!-- 浮动辅导助手按钮 -->
  <view class="float-btn" bindtap="toggleFloatChat">
    <text class="float-icon">💬</text>
  </view>

  <!-- 辅导浮窗 -->
  <view wx:if="{{showFloatChat}}" class="float-overlay">
    <view class="float-panel">
      <view class="float-header">
        <text class="float-title">AI 辅导助手</text>
        <text class="float-close" catchtap="closeFloatChat">✕</text>
      </view>
      <scroll-view scroll-y class="float-chat-box" scroll-into-view="fmsg-{{floatChatHistory.length}}">
        <block wx:for="{{floatChatHistory}}" wx:key="id">
          <view id="fmsg-{{index}}" class="float-msg {{item.role === 'user' ? 'right' : 'left'}}">
            <view wx:if="{{item.role === 'ai'}}" class="float-avatar">🤖</view>
            <view class="float-bubble {{item.role}}">
              <rich-text wx:if="{{item.renderedHtml}}" nodes="{{item.renderedHtml}}"></rich-text>
              <text wx:else>{{item.content}}</text>
            </view>
            <view wx:if="{{item.role === 'user'}}" class="float-avatar user">👤</view>
          </view>
        </block>
      </scroll-view>
      <view class="float-input-row">
        <input class="float-input" placeholder="输入问题..." value="{{floatInputValue}}" bindinput="onFloatInput" />
        <view class="float-send" catchtap="sendFloatQuestion">发送</view>
      </view>
    </view>
  </view>
</view>