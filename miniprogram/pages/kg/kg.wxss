.kg-container {
  min-height: 100vh;
  background: #fff;
  display: flex;
  flex-direction: column;
}

.kg-header {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #E5E7EB;
}

.back-btn {
  width: 100rpx;
  height: 60rpx;
  background: #F3F4F6;
  color: #374151;
  border-radius: 30rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin-right: 20rpx;
}

.kg-title {
  flex: 1;
  color: #1F2937;
  font-size: 32rpx;
  font-weight: 600;
}

.canvas-wrapper {
  flex: 1;
  padding: 20rpx;
  background: #F9FAFB;
}

.kg-canvas {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  background: #fff;
}

.kg-legend {
  padding: 20rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #E5E7EB;
}

.legend-title {
  font-size: 26rpx;
  color: #6B7280;
  margin-bottom: 10rpx;
  display: block;
}

.legend-items {
  display: flex;
  gap: 40rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}

.legend-line {
  width: 40rpx;
  height: 4rpx;
  background: #CBD5E1;
}

.legend-label {
  font-size: 24rpx;
  color: #6B7280;
}

.kg-stats {
  padding: 20rpx 30rpx;
  background: #fff;
  display: flex;
  justify-content: center;
  gap: 60rpx;
}

.stat-item {
  font-size: 26rpx;
  color: #374151;
}