.profile-container {
  min-height: 100vh;
  background: var(--color-bg-page);
  display: flex;
  flex-direction: column;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: var(--color-bg-card);
  border-bottom: 1rpx solid var(--color-border-light);
}

.page-title {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--color-text-ink);
}

.header-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.notification-wrap {
  position: relative;
}

.notification-icon {
  font-size: 36rpx;
}

.badge {
  position: absolute;
  top: -8rpx;
  right: -12rpx;
  background: var(--color-error);
  color: var(--color-text-inverse);
  font-size: 20rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.greeting {
  font-size: 26rpx;
  color: var(--color-text-muted);
}

.logout-btn {
  font-size: 24rpx;
  color: var(--color-text-faint);
  padding: 6rpx 16rpx;
  margin-top: 4rpx;
}

.user-menu {
  display: flex;
  background: var(--color-bg-card);
  padding: 0 20rpx;
  border-bottom: 1rpx solid var(--color-border-light);
}

.menu-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  gap: 8rpx;
}

.menu-icon {
  font-size: 40rpx;
}

.menu-text {
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.main-content {
  flex: 1;
  padding: 20rpx;
  height: calc(100vh - 200rpx);
}

.chat-section {
  background: var(--color-bg-card);
  border-radius: 24rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--color-border-light);
}

.section-header {
  margin-bottom: 25rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: var(--color-text-ink);
  margin-bottom: 8rpx;
}

.section-subtitle {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.chat-box {
  height: 400rpx;
  margin-bottom: 20rpx;
}

.message {
  display: flex;
  margin-bottom: 25rpx;
}

.user-msg {
  flex-direction: row-reverse;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 15rpx;
  font-size: 32rpx;
  flex-shrink: 0;
}

.ai-avatar {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-deep) 100%);
  color: var(--color-text-inverse);
}

.user-avatar {
  background: var(--color-student-pale);
  color: var(--color-student);
}

.bubble {
  max-width: 75%;
  padding: 20rpx 25rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.ai-msg .bubble {
  background: var(--color-bg-card-soft);
  border-top-left-radius: 4rpx;
  color: var(--color-text-body);
  border: 1rpx solid var(--color-border-light);
}

.user-msg .bubble {
  background: linear-gradient(135deg, var(--color-student) 0%, var(--color-student-soft) 100%);
  color: var(--color-text-inverse);
  border-top-right-radius: 4rpx;
}

.thinking-status {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--color-primary);
  display: flex;
  align-items: center;
}

.dot {
  animation: blink 1s infinite;
  margin-right: 8rpx;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

.input-area {
  display: flex;
  gap: 15rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--color-border-light);
  align-items: center;
}

.voice-wrap {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.voice-recording-group {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.voice-btn {
  width: 76rpx;
  height: 76rpx;
  border-radius: 16rpx;
  background: var(--color-bg-card-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  position: relative;
  transition: all 0.2s;
  border: 1rpx solid var(--color-border-light);
}

.voice-btn.recording {
  background: var(--color-error-soft);
  color: var(--color-error);
  animation: pulse 1.2s ease-in-out infinite;
}

.voice-btn.cancel {
  width: 76rpx;
  height: 76rpx;
  border-radius: 16rpx;
  background: var(--color-bg-card-soft);
  color: var(--color-text-muted);
  font-size: 32rpx;
}

.voice-btn.loading {
  background: var(--color-bg-card-soft);
  color: var(--color-text-faint);
}

.recording-time {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  background: var(--color-error);
  color: var(--color-text-inverse);
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 16rpx;
  line-height: 1.2;
}

.input-row {
  display: flex;
  flex: 1;
  gap: 15rpx;
  align-items: center;
}

.recording-hint {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-error);
}

@keyframes pulse {
  0%, 100% {
    box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.4);
  }
  50% {
    box-shadow: 0 0 0 12rpx rgba(220, 38, 38, 0);
  }
}

.input-box {
  flex: 1;
  background: var(--color-bg-card-soft);
  border: 1rpx solid var(--color-border-light);
  border-radius: 40rpx;
  padding: 0 25rpx;
  font-size: 26rpx;
  height: 76rpx;
  color: var(--color-text-body);
}

.send-btn {
  width: 110rpx;
  min-width: 110rpx;
  height: 76rpx;
  background: linear-gradient(135deg, var(--color-student) 0%, var(--color-student-soft) 100%);
  color: var(--color-text-inverse);
  border-radius: 40rpx;
  font-size: 26rpx;
}

.profile-section {
  background: var(--color-bg-card);
  border-radius: 24rpx;
  padding: 25rpx;
  border: 1rpx solid var(--color-border-light);
}

.profile-card {
  padding-top: 10rpx;
}

.profile-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.profile-item {
  flex: 1;
  background: var(--color-bg-card-soft);
  border-radius: 16rpx;
  padding: 15rpx;
  border: 1rpx solid var(--color-border-light);
}

.profile-item .label {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-bottom: 8rpx;
}

.profile-item .value {
  font-size: 26rpx;
  color: var(--color-text-body);
  font-weight: 500;
}

.profile-item .value.pending {
  color: var(--color-text-faint);
}

.divider {
  height: 1rpx;
  background: var(--color-border-light);
  margin: 20rpx 0;
}

.profile-section-title {
  font-size: 26rpx;
  color: var(--color-text-ink);
  font-weight: bold;
  margin-bottom: 15rpx;
}

.tags-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag {
  background: var(--color-primary-pale);
  color: var(--color-primary);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.tag.weak {
  background: var(--color-student-pale);
  color: var(--color-student);
}

.empty-text {
  font-size: 22rpx;
  color: var(--color-text-faint);
}

.generate-path-btn {
  margin-top: 25rpx;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-deep) 100%);
  color: var(--color-text-inverse);
  border-radius: 40rpx;
  height: 88rpx;
  font-size: 30rpx;
  font-weight: bold;
}

.workflow-progress {
  background: var(--color-primary-pale);
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid var(--color-primary-pale);
}

.workflow-progress-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.workflow-icon {
  font-size: 28rpx;
}

.workflow-label {
  flex: 1;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.workflow-pct {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.progress-bar {
  height: 12rpx;
  background: var(--color-border-light);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--color-primary), var(--color-student));
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(29, 30, 48, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  background: var(--color-bg-card);
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid var(--color-border-light);
}

.modal-content.small {
  width: 500rpx;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid var(--color-border-light);
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--color-text-ink);
}

.modal-close {
  font-size: 32rpx;
  color: var(--color-text-muted);
  padding: 10rpx;
}

.modal-body {
  padding: 30rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.profile-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.empty-profiles {
  text-align: center;
  color: var(--color-text-muted);
  padding: 40rpx;
}

.profile-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background: var(--color-bg-card-soft);
  border-radius: 16rpx;
  border: 1rpx solid var(--color-border-light);
}

.profile-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.profile-name {
  font-size: 28rpx;
  color: var(--color-text-body);
  font-weight: 500;
}

.profile-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

.profile-status.active {
  background: var(--color-success-soft);
  color: var(--color-success);
}

.profile-status.archived {
  background: var(--color-bg-page-2);
  color: var(--color-text-faint);
}

.profile-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  font-size: 24rpx;
  color: var(--color-text-muted);
  padding: 8rpx 16rpx;
}

.action-btn.warning {
  color: var(--color-warning);
}

.action-btn.success {
  color: var(--color-success);
}

.edit-profile {
  flex: 1;
}

.edit-input {
  width: 100%;
  font-size: 28rpx;
  padding: 10rpx;
  border: 1rpx solid var(--color-primary);
  border-radius: 8rpx;
  color: var(--color-text-body);
}

.add-profile-btn {
  margin-top: 20rpx;
  width: 100%;
  border: 2rpx dashed var(--color-border);
  color: var(--color-text-muted);
  border-radius: 16rpx;
  height: 80rpx;
  font-size: 28rpx;
  background: transparent;
}

.profile-name-input {
  width: 100%;
  font-size: 28rpx;
  padding: 20rpx;
  border: 1rpx solid var(--color-border-light);
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  color: var(--color-text-body);
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.modal-btn.cancel {
  background: var(--color-bg-card-soft);
  color: var(--color-text-muted);
  border: 1rpx solid var(--color-border-light);
}

.modal-btn.confirm {
  background: var(--color-student);
  color: var(--color-text-inverse);
}

.profile-header-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--color-border-light);
}

.profile-name-display {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.profile-name-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-ink);
}

.dropdown-arrow {
  font-size: 20rpx;
  color: var(--color-text-muted);
}

.profile-complete-tip {
  background: var(--color-success-soft);
  color: var(--color-success);
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--color-success-soft);
}

.bubble-wrap {
  max-width: 75%;
  display: flex;
  flex-direction: column;
}

.msg-meta {
  margin-top: 8rpx;
}

.msg-time {
  font-size: 22rpx;
  color: var(--color-text-faint);
}

.user-msg .msg-time {
  text-align: right;
}

.typing-indicator {
  display: inline-flex;
  gap: 8rpx;
  padding: 10rpx 0;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-primary);
  opacity: 0.4;
  animation: typing-bounce 1.2s ease-in-out infinite;
}

.typing-dot:nth-child(2) {
  animation-delay: 0.15s;
}

.typing-dot:nth-child(3) {
  animation-delay: 0.3s;
}

@keyframes typing-bounce {
  0%, 60%, 100% {
    transform: translateY(0);
    opacity: 0.4;
  }
  30% {
    transform: translateY(-8rpx);
    opacity: 1;
  }
}

.dropdown-content {
  width: 500rpx;
  background: var(--color-bg-card);
  border-radius: 24rpx;
  overflow: hidden;
  margin-top: 80rpx;
  border: 1rpx solid var(--color-border-light);
}

.dropdown-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
}

.dropdown-item-name {
  font-size: 28rpx;
  color: var(--color-text-body);
}

.dropdown-item-name.add {
  color: var(--color-primary);
}

.dropdown-item-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

.dropdown-item-status.active {
  background: var(--color-success-soft);
  color: var(--color-success);
}

.dropdown-divider {
  height: 1rpx;
  background: var(--color-border-light);
}

/* === 编辑画像按钮 === */
.edit-profile-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 28rpx;
  background: var(--color-student);
  color: #FFFFFF;
  border-radius: 28rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(176, 81, 44, 0.22);
}

.edit-icon {
  font-size: 28rpx;
}

.edit-text {
  font-size: 26rpx;
}

/* === 编辑画像弹窗 === */
.modal-content.edit-modal {
  width: 680rpx;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
}

.edit-body {
  flex: 1;
  padding: 32rpx;
  max-height: 60vh;
}

.edit-field {
  margin-bottom: 32rpx;
}

.edit-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary);
  margin-bottom: 16rpx;
}

.edit-input-box {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--color-bg-page);
  border: 2rpx solid var(--color-border-light);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--color-text-ink);
  box-sizing: border-box;
}

.edit-input-box:focus {
  border-color: var(--color-student);
  background: #fff;
}

.tag-editor {
  background: var(--color-bg-page);
  border: 2rpx solid var(--color-border-light);
  border-radius: 16rpx;
  padding: 20rpx;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
  min-height: 60rpx;
}

.editable-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  border-radius: 20rpx;
  font-size: 26rpx;
}

.editable-tag.weak {
  background: var(--color-student);
}

.tag-text {
  font-size: 26rpx;
}

.tag-remove {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  padding: 4rpx 8rpx;
  min-width: 40rpx;
  min-height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-hint {
  font-size: 26rpx;
  color: var(--color-text-faint);
  padding: 12rpx 0;
}

.tag-input-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.tag-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
  border: 2rpx solid var(--color-border-light);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--color-text-ink);
}

.tag-add-btn {
  min-width: 120rpx;
  height: 72rpx;
  padding: 0 24rpx;
  background: var(--color-student);
  color: #FFFFFF;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-btn.cancel {
  background: var(--color-bg-page);
  color: var(--color-text-muted);
  border: 2rpx solid var(--color-border-light);
}

.modal-btn.confirm {
  background: var(--color-student);
  color: #FFFFFF;
}
