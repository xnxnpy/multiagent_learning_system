.container {
  padding: 24rpx 28rpx 60rpx;
  min-height: 100vh;
  background: #F7F5F0;
}
.page-title { font-size: 40rpx; font-weight: 700; display: block; }
.page-desc { font-size: 24rpx; color: #8A8FA3; margin-top: 8rpx; display: block; margin-bottom: 24rpx; }
.stats-row { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.stat-card {
  flex: 1; background: #fff; border-radius: 16rpx; padding: 20rpx;
  text-align: center; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.stat-value { font-size: 40rpx; font-weight: 700; display: block; color: #2B2D42; }
.stat-value.warn { color: #DC2626; }
.stat-label { font-size: 22rpx; color: #8A8FA3; }
.upload-btn {
  width: 100%; background: #B0512C; color: #fff; border-radius: 12rpx;
  font-size: 28rpx; margin-bottom: 28rpx; border: none;
}
.section-title { font-size: 28rpx; font-weight: 600; margin-bottom: 16rpx; }
.loading, .empty { text-align: center; color: #8A8FA3; padding: 40rpx 0; font-size: 26rpx; }
.doc-item {
  display: flex; align-items: center; background: #fff;
  border-radius: 14rpx; padding: 22rpx; margin-bottom: 14rpx;
}
.doc-main { flex: 1; min-width: 0; }
.doc-name { font-size: 28rpx; font-weight: 500; display: block; word-break: break-all; }
.doc-meta { font-size: 22rpx; color: #8A8FA3; margin-top: 6rpx; display: block; }
.doc-meta .ok { color: #16A34A; }
.doc-meta .bad { color: #DC2626; }
.doc-del { color: #DC2626; font-size: 24rpx; padding: 8rpx 12rpx; }
.pager { display: flex; align-items: center; justify-content: center; gap: 20rpx; margin-top: 24rpx; }
.page-num { font-size: 24rpx; color: #8A8FA3; }
