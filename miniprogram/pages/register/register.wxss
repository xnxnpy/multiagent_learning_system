/* ========== 注册页 · 学术编辑风格 ========== */
.container {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding: 60rpx 40rpx 80rpx;
  box-sizing: border-box;
  position: relative;
}

/* 顶部装饰：纸张纹理底 */
.container::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 380rpx;
  background: linear-gradient(180deg, rgba(43, 45, 66, 0.06) 0%, rgba(176, 81, 44, 0.04) 60%, transparent 100%);
  border-bottom: 1rpx solid var(--color-border-light);
  pointer-events: none;
}

/* ---------- Logo 区 ---------- */
.logo-section {
  text-align: center;
  margin-bottom: 56rpx;
  position: relative;
  z-index: 1;
}

.logo {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  border-radius: 28rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 56rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(43, 45, 66, 0.18);
  font-family: 'Times New Roman', serif;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-text-ink);
  margin-bottom: 10rpx;
  letter-spacing: -0.02em;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-muted);
  letter-spacing: 0.01em;
}

/* ---------- 表单区（纸张卡片）---------- */
.form-section {
  background: var(--color-bg-card);
  border-radius: 28rpx;
  padding: 40rpx 36rpx 40rpx;
  box-shadow: 0 2rpx 8rpx rgba(29, 31, 51, 0.05),
              0 2rpx 4rpx rgba(29, 31, 51, 0.04);
  border: 1rpx solid var(--color-border-light);
  position: relative;
  z-index: 1;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-body);
  margin-bottom: 12rpx;
  font-weight: 600;
  letter-spacing: 0.01em;
}

.required {
  color: var(--color-error);
  margin-left: 4rpx;
  font-weight: 700;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: 20rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: var(--color-text-body);
  box-sizing: border-box;
  transition: all 0.15s;
}

.form-input:focus {
  border-color: rgba(43, 45, 66, 0.35);
  box-shadow: 0 0 0 4rpx rgba(43, 45, 66, 0.06);
}

/* ---------- 角色选项 ---------- */
.role-options {
  display: flex;
  gap: 20rpx;
}

.role-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 16rpx;
  border: 1rpx solid var(--color-border-light);
  border-radius: 20rpx;
  background: var(--color-bg-card-soft);
  transition: all 0.2s;
}

.role-option.active {
  border-color: var(--color-student);
  background: var(--color-student-pale);
  box-shadow: 0 2rpx 8rpx rgba(176, 81, 44, 0.12);
}

.role-option.active.role-option-teacher {
  border-color: var(--color-teacher);
  background: var(--color-teacher-pale);
  box-shadow: 0 2rpx 8rpx rgba(61, 107, 79, 0.12);
}

.role-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.role-label {
  font-size: 26rpx;
  color: var(--color-text-muted);
  font-weight: 500;
}

.role-option.active .role-label {
  color: var(--color-student);
  font-weight: 700;
}
.role-option.active.role-option-teacher .role-label {
  color: var(--color-teacher);
  font-weight: 700;
}

/* ---------- 用户协议 ---------- */
.agreement-item {
  display: flex;
  align-items: center;
  margin: 8rpx 0 36rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid var(--color-border-strong);
  border-radius: 10rpx;
  margin-right: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  transition: all 0.15s;
}

.checkbox.checked {
  background: var(--color-student);
  border-color: var(--color-student);
}

.agreement-text {
  font-size: 24rpx;
  color: var(--color-text-muted);
}

/* ---------- 提交按钮：陶土橙学生主色 ---------- */
.submit-btn {
  width: 100%;
  height: 92rpx;
  background: var(--color-student);
  color: var(--color-text-inverse);
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 24rpx;
  border: none;
  letter-spacing: 0.04em;
  box-shadow: 0 4rpx 12rpx rgba(176, 81, 44, 0.18);
  transition: all 0.2s;
}

.submit-btn:active {
  background: #964527;
  transform: translateY(-1rpx);
  box-shadow: 0 6rpx 16rpx rgba(176, 81, 44, 0.26);
}

.submit-btn[disabled] {
  opacity: 0.5;
  box-shadow: none;
}

/* ---------- 登录跳转 ---------- */
.login-link {
  text-align: center;
  margin-top: 36rpx;
  font-size: 26rpx;
  color: var(--color-text-muted);
  position: relative;
  z-index: 1;
}

.link-text {
  color: var(--color-primary);
  font-weight: 700;
  margin-left: 6rpx;
  text-decoration: underline;
  text-underline-offset: 3rpx;
  text-decoration-thickness: 1rpx;
}
