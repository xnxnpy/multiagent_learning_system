.tutor-container {
  min-height: 100vh;
  background: var(--color-bg-page);
  display: flex;
  flex-direction: column;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
  background: var(--color-bg-card);
  border-bottom: 1rpx solid var(--color-border-light);
}

.header-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.ai-avatar-header {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--color-text-inverse);
  box-shadow: 0 2rpx 8rpx rgba(43, 45, 66, 0.15);
}

.header-info {
  display: flex;
  flex-direction: column;
}

.page-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text-ink);
  letter-spacing: -0.02em;
}

.page-status {
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-top: 4rpx;
}

.header-right {
  display: flex;
  gap: 16rpx;
}

.header-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: var(--color-primary-faint);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--color-primary);
  transition: all 0.15s;
}

.header-btn:active {
  background: var(--color-primary-pale);
  transform: scale(0.96);
}

.session-sidebar {
  position: fixed;
  top: 132rpx;
  right: 0;
  width: 500rpx;
  height: calc(100vh - 132rpx);
  background: var(--color-bg-sidebar);
  z-index: 100;
  box-shadow: -4rpx 0 20rpx rgba(29, 31, 51, 0.08);
  display: flex;
  flex-direction: column;
  border-left: 1rpx solid var(--color-border-light);
}

.sidebar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 28rpx;
  border-bottom: 1rpx solid var(--color-border-light);
}

.sidebar-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-ink);
  letter-spacing: -0.02em;
}

.close-btn {
  font-size: 32rpx;
  color: var(--color-text-muted);
  padding: 8rpx 16rpx;
}

.sidebar-top {
  padding: 20rpx;
  border-bottom: 1rpx solid var(--color-border-light);
}

.new-chat-btn {
  width: 100%;
  padding: 20rpx;
  background: transparent;
  border: 2rpx dashed var(--color-border);
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--color-text-muted);
  font-weight: 500;
}

.new-chat-btn:active {
  border-color: var(--color-student);
  color: var(--color-student);
  background: var(--color-student-pale);
}

.session-list {
  flex: 1;
  padding: 20rpx;
}

.empty-sessions {
  text-align: center;
  padding: 80rpx 0;
}

.session-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: var(--color-bg-card-soft);
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid var(--color-border-light);
  transition: all 0.15s;
}

.session-item:active {
  background: var(--color-student-pale);
  border-color: var(--color-student-soft);
}

.session-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
  color: var(--color-primary);
}

.session-info {
  flex: 1;
  min-width: 0;
}

.session-num {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-ink);
  margin-bottom: 6rpx;
}

.session-preview {
  font-size: 24rpx;
  color: var(--color-text-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session-time {
  font-size: 20rpx;
  color: var(--color-text-faint);
  margin-top: 6rpx;
}

.session-delete {
  font-size: 28rpx;
  color: var(--color-text-faint);
  padding: 8rpx;
}

.session-delete:active {
  color: var(--color-error);
}

.sidebar-bottom {
  padding: 20rpx;
  border-top: 1rpx solid var(--color-border-light);
}

.clear-all-btn {
  width: 100%;
  padding: 16rpx;
  background: transparent;
  border: none;
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.clear-all-btn:active {
  color: var(--color-error);
  background: var(--color-error-soft);
  border-radius: 12rpx;
}

.main-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 24rpx;
  height: calc(100vh - 132rpx);
  box-sizing: border-box;
}

.chat-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: var(--color-bg-card);
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(29, 31, 51, 0.04);
  border: 1rpx solid var(--color-border-light);
}

.section-header {
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--color-border-light);
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-ink);
  margin-bottom: 6rpx;
}

.section-subtitle {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.chat-box {
  flex: 1;
  min-height: 400rpx;
}

.msg-row {
  display: flex;
  margin-bottom: 8rpx;
  align-items: flex-start;
}

.msg-row.right {
  flex-direction: row-reverse;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.avatar-placeholder {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
}

.ai-avatar {
  background: var(--color-primary);
  color: var(--color-text-inverse);
  box-shadow: 0 2rpx 6rpx rgba(43, 45, 66, 0.18);
}

.user-avatar {
  background: var(--color-student-pale);
  color: var(--color-student);
}

.msg-content {
  max-width: 76%;
  padding: 10rpx 16rpx;
  border-radius: 24rpx;
  margin: 0 12rpx;
  line-height: 1.5;
  word-break: break-all;
  overflow: hidden;
}

/* ============ Token 渲染样式 ============ */
.msg-content view,
.msg-content text {
  margin: 0 !important;
  padding: 0 !important;
  display: block;
  box-sizing: border-box;
}

.tk-heading {
  display: block;
  font-weight: 700;
  color: var(--color-text-ink);
  padding: 0;
  margin: 0 !important;
  line-height: 1.4;
}

.tk-heading.tk-h1 { font-size: 32rpx; margin: 4rpx 0 !important; }
.tk-heading.tk-h2 { font-size: 28rpx; margin: 4rpx 0 !important; }
.tk-heading.tk-h3 { font-size: 26rpx; margin: 2rpx 0 !important; }
.tk-heading.tk-h4 { font-size: 24rpx; margin: 2rpx 0 !important; }

.tk-paragraph {
  display: block;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--color-text-body);
  padding: 0;
  margin: 0 !important;
  word-break: break-all;
  white-space: pre-wrap;
}

.tk-list-item {
  display: flex;
  align-items: flex-start;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--color-text-body);
  padding: 0;
  margin: 0 !important;
}

.tk-list-bullet {
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--color-primary);
  width: 32rpx;
  text-align: right;
  margin-right: 8rpx;
}

.tk-list-text {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--color-text-body);
  word-break: break-all;
}

.tk-quote {
  border-left: 4rpx solid var(--color-student);
  background: var(--color-primary-pale);
  padding: 4rpx 12rpx;
  margin: 0 !important;
  border-radius: 0 10rpx 10rpx 0;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--color-text-body);
}

.tk-quote text {
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--color-text-body);
}

.tk-code-block {
  margin: 4rpx 0 !important;
  border-radius: 12rpx;
  border: 1rpx solid var(--color-border-light);
  background: #fff;
  overflow: hidden;
}

.tk-code-header {
  padding: 4rpx 12rpx;
  background: #f8fafc;
  border-bottom: 1rpx solid var(--color-border-light);
}

.tk-code-lang {
  font-size: 20rpx;
  color: var(--color-text-muted);
  font-family: 'SF Mono', 'Courier New', monospace;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.tk-code-body {
  display: block;
  padding: 10rpx 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #24292e;
  font-family: 'SF Mono', 'Courier New', monospace;
  white-space: pre-wrap;
  word-break: break-all;
}

.tk-hr {
  height: 1rpx;
  background: var(--color-border-light);
  margin: 4rpx 0 !important;
}

.msg-row.left .msg-content {
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-top-left-radius: 6rpx;
}

.msg-row.right .msg-content {
  background: var(--color-student);
  color: var(--color-text-inverse);
  border-top-right-radius: 6rpx;
  box-shadow: 0 4rpx 12rpx rgba(176, 81, 44, 0.2);
}

.msg-row.right .msg-content .tk-heading,
.msg-row.right .msg-content .tk-paragraph,
.msg-row.right .msg-content .tk-list-text {
  color: var(--color-text-inverse);
}

.msg-row.right .msg-content .tk-list-bullet {
  color: rgba(255, 255, 255, 0.7);
}

.msg-row.right .msg-content .tk-quote {
  background: rgba(255, 255, 255, 0.15);
  border-left-color: rgba(255, 255, 255, 0.4);
  color: var(--color-text-inverse);
}

.msg-row.right .msg-content .tk-quote text {
  color: var(--color-text-inverse);
}

.msg-row.right .msg-content .tk-code-block {
  background: rgba(255, 255, 255, 0.15);
  border-color: rgba(255, 255, 255, 0.3);
}

.msg-row.right .msg-content .tk-code-header {
  background: rgba(255, 255, 255, 0.1);
  border-bottom-color: rgba(255, 255, 255, 0.2);
}

.msg-row.right .msg-content .tk-code-body {
  color: var(--color-text-inverse);
}

.msg-row.right .msg-content .tk-hr {
  background: rgba(255, 255, 255, 0.3);
}

/* 删除通用 .msg-content text 规则，改为只用于用户消息的 .msg-text */
.msg-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--color-text-inverse);
  word-break: break-all;
  white-space: normal;
}

.msg-row.right .msg-content .msg-text {
  color: var(--color-text-inverse);
}

/* 待发送图片附件卡片 */
.pending-chip {
  display: flex;
  align-items: center;
  gap: 16rpx;
  align-self: flex-start;
  max-width: 520rpx;
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border-light);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  position: relative;
}

.pending-thumb {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: var(--color-bg-page-2);
}

.pending-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
  flex: 1;
}

.pending-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 320rpx;
}

.pending-size {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.pending-remove {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--color-bg-page-2);
  color: var(--color-text-muted);
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  flex-shrink: 0;
  transition: all 0.15s;
}

.pending-remove:active {
  background: #ef4444;
  color: #fff;
}

/* 聊天消息中的图片缩略图 */
.msg-thumb {
  width: 100%;
  max-width: 320rpx;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.msg-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--color-text-inverse);
}

.typing-indicator {
  display: flex;
  gap: 12rpx;
  padding: 24rpx 28rpx;
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: 24rpx;
  border-top-left-radius: 6rpx;
  margin: 0 16rpx;
}

.typing-indicator .dot {
  width: 14rpx;
  height: 14rpx;
  background: var(--color-primary);
  border-radius: 50%;
  animation: typing 1.4s infinite ease-in-out;
  opacity: 0.6;
}

.typing-indicator .dot:nth-child(1) { animation-delay: 0s; }
.typing-indicator .dot:nth-child(2) { animation-delay: 0.2s; }
.typing-indicator .dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes typing {
  0%, 80%, 100% { transform: scale(0); opacity: 0.3; }
  40% { transform: scale(1); opacity: 0.8; }
}

@keyframes pulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(161, 59, 59, 0.3); }
  50% { box-shadow: 0 0 0 16rpx rgba(161, 59, 59, 0); }
}

.quick-questions {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--color-border-light);
}

.quick-title {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-muted);
  font-weight: 500;
  margin-bottom: 20rpx;
  letter-spacing: 0.02em;
}

.quick-list {
  white-space: nowrap;
}

.quick-item {
  display: inline-block;
  background: var(--color-student-pale);
  padding: 18rpx 32rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--color-student);
  margin-right: 16rpx;
  font-weight: 500;
  transition: all 0.15s;
  border: 1rpx solid transparent;
}

.quick-item:active {
  background: var(--color-student-soft);
  border-color: var(--color-student);
  transform: scale(0.98);
}

.input-area {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 24rpx;
  background: var(--color-bg-card);
  border-radius: 28rpx;
  border: 1rpx solid var(--color-border-light);
  box-shadow: 0 2rpx 8rpx rgba(29, 31, 51, 0.04);
}

.pending-image-wrap {
  display: flex;
  justify-content: flex-start;
}

.toolbar-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.toolbar-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.toolbar-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
  margin-left: auto;
}

.voice-wrap {
  display: flex;
  align-items: center;
}

.image-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  background: var(--color-bg-page-2);
  border: 1rpx solid var(--color-border-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--color-primary);
  transition: all 0.15s;
}

.image-btn:active {
  background: var(--color-primary-faint);
  border-color: var(--color-primary-pale);
  transform: scale(0.95);
}

.voice-recording-group {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.voice-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  background: var(--color-bg-page-2);
  border: 1rpx solid var(--color-border-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--color-primary);
  position: relative;
  transition: all 0.15s;
}

.voice-btn:active {
  transform: scale(0.95);
}

.voice-btn.recording {
  background: var(--color-error-soft);
  border-color: var(--color-error);
  color: var(--color-error);
  animation: pulse 1.2s ease-in-out infinite;
}

.voice-btn.cancel {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  background: var(--color-bg-page-2);
  border: 1rpx solid var(--color-border-light);
  color: var(--color-text-muted);
  font-size: 28rpx;
}

.voice-btn.loading {
  background: var(--color-bg-page-2);
  border-color: var(--color-border-light);
  color: var(--color-text-faint);
}

.recording-time {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background: var(--color-error);
  color: var(--color-text-inverse);
  font-size: 18rpx;
  padding: 3rpx 10rpx;
  border-radius: 18rpx;
  line-height: 1.2;
  font-weight: 600;
}

.input-row {
  display: flex;
  flex: 1;
  min-width: 0;
  gap: 10rpx;
  align-items: center;
}

.recording-hint {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-error);
  background: var(--color-error-soft);
  padding: 16rpx;
  border-radius: 12rpx;
  border-radius: 40rpx;
}

.input {
  flex: 1;
  min-width: 0;
  min-height: 72rpx;
  max-height: 200rpx;
  background: var(--color-bg-page-2);
  border: 1rpx solid var(--color-border-light);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  color: var(--color-text-body);
  line-height: 1.5;
}

.send-btn {
  width: 112rpx;
  min-width: 112rpx;
  height: 72rpx;
  background: var(--color-student);
  color: var(--color-text-inverse);
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 3rpx 10rpx rgba(176, 81, 44, 0.18);
  transition: all 0.15s;
  border: none;
  margin: 0;
  padding: 0;
}

.send-btn::after {
  border: none;
}

.send-btn[disabled] {
  background: var(--color-border-strong);
  color: var(--color-text-inverse);
  box-shadow: none;
  opacity: 0.5;
}

.send-btn:active:not([disabled]) {
  background: #964527;
  transform: translateY(-1rpx);
  box-shadow: 0 5rpx 14rpx rgba(176, 81, 44, 0.24);
}
