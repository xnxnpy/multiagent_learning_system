.report-container {
  min-height: 100vh;
  background: #f5f7fa;
  display: flex;
  flex-direction: column;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.page-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1a1a2e;
}

.refresh-btn {
  background: #4F46E5;
  color: #fff;
  border-radius: 32rpx;
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  line-height: 1.4;
}

.main-content {
  flex: 1;
  padding: 20rpx;
  height: calc(100vh - 100rpx);
}

/* 2x2 统计卡片网格 */
.stat-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx 20rpx;
}

.stat-card {
  width: 50%;
  box-sizing: border-box;
  padding: 0 8rpx;
  margin-bottom: 16rpx;
}

.stat-card > view {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.stat-card.mini > view {
  padding: 20rpx 16rpx;
}

.stat-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.stat-icon.trophy { background: #FFF7ED; }
.stat-icon.score { background: #EEF2FF; }
.stat-icon.questions { background: #E0F2FE; }
.stat-icon.accuracy { background: #F0FDF4; }

.stat-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #1a1a2e;
}

.stat-value.grade {
  font-size: 30rpx;
  color: #4F46E5;
}

.stat-label {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 4rpx;
}

/* 两列布局 */
.two-col {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.col-left {
  flex: 1;
  min-width: 0;
}

.col-right {
  flex: 1;
  min-width: 0;
}

.content-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.card-tag {
  font-size: 22rpx;
  color: #4F46E5;
  background: #EEF2FF;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

/* 知识点列表 */
.knowledge-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.kp-item {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.kp-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.kp-name {
  font-size: 24rpx;
  color: #374151;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.kp-score {
  font-size: 22rpx;
  color: #4F46E5;
  font-weight: 600;
  margin-left: 8rpx;
}

.progress-track {
  height: 10rpx;
  background: #F3F4F6;
  border-radius: 5rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 5rpx;
  transition: width 0.3s;
}

.progress-fill.success { background: #10B981; }
.progress-fill.warning { background: #F59E0B; }
.progress-fill.exception { background: #EF4444; }

.kp-status {
  font-size: 20rpx;
  font-weight: 500;
}

.kp-status.success { color: #10B981; }
.kp-status.warning { color: #F59E0B; }
.kp-status.danger { color: #EF4444; }

/* 学习建议 */
.suggestion-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.suggestion-item {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
}

.sug-icon {
  font-size: 24rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.sug-text {
  font-size: 24rpx;
  color: #4B5563;
  line-height: 1.6;
}

/* 学习趋势 */
.trend-chart {
  padding: 16rpx 0;
}

.trend-bars {
  display: flex;
  justify-content: space-around;
  align-items: flex-end;
  height: 200rpx;
}

.bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  flex: 1;
}

.bar-wrapper {
  width: 36rpx;
  height: 160rpx;
  background: #F3F4F6;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  overflow: hidden;
}

.bar-fill {
  background: linear-gradient(180deg, #4F46E5, #818CF8);
  border-radius: 8rpx;
  min-height: 4rpx;
  transition: height 0.3s;
}

.bar-value {
  font-size: 18rpx;
  color: #6B7280;
  font-weight: 500;
}

.bar-label {
  font-size: 18rpx;
  color: #9CA3AF;
}

/* 行为分布 */
.behavior-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.behavior-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.behavior-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.behavior-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.behavior-name {
  font-size: 24rpx;
  color: #374151;
}

.behavior-value {
  font-size: 24rpx;
  font-weight: 600;
  color: #1a1a2e;
}

/* 详细报告 */
.report-text {
  font-size: 26rpx;
  color: #4B5563;
  line-height: 1.8;
}

/* 循环提升 */
.loop-card {
  margin-bottom: 40rpx;
}

.loop-desc {
  font-size: 24rpx;
  color: #6B7280;
  margin-bottom: 20rpx;
  line-height: 1.6;
}

.loop-actions {
  display: flex;
  gap: 16rpx;
}

.loop-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loop-btn.primary {
  background: #4F46E5;
  color: #fff;
}

.loop-btn.success {
  background: #10B981;
  color: #fff;
}

.loop-btn.default {
  background: #F3F4F6;
  color: #374151;
}

/* 空状态 */
.empty-state {
  padding: 40rpx 20rpx;
  text-align: center;
}

.empty-text {
  font-size: 24rpx;
  color: #9CA3AF;
}

/* 表格样式 */
.table-wrap {
  border: 1rpx solid #E5E7EB;
  border-radius: 12rpx;
  overflow: hidden;
}

.table-header {
  display: flex;
  background: #F9FAFB;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #E5E7EB;
}

.th {
  font-size: 22rpx;
  font-weight: 600;
  color: #6B7280;
}

.table-row {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.table-row:last-child {
  border-bottom: none;
}

.table-row.even {
  background: #FAFAFA;
}

.td {
  font-size: 24rpx;
  color: #374151;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mini-progress {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.mini-track {
  flex: 1;
  height: 8rpx;
  background: #F3F4F6;
  border-radius: 4rpx;
  overflow: hidden;
}

.mini-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.3s;
}

.mini-fill.success { background: #10B981; }
.mini-fill.warning { background: #F59E0B; }
.mini-fill.exception { background: #EF4444; }

.mini-pct {
  font-size: 20rpx;
  color: #6B7280;
  min-width: 60rpx;
  text-align: right;
}

.status-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.status-tag.success { background: #D1FAE5; color: #059669; }
.status-tag.warning { background: #FEF3C7; color: #D97706; }
.status-tag.danger { background: #FEE2E2; color: #DC2626; }
