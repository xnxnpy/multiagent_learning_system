.report-container {
  min-height: 100vh;
  background: var(--color-bg-page);
  display: flex;
  flex-direction: column;
}

/* ── 顶部导航栏 ────────────────────────────── */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background: var(--color-bg-card);
  border-bottom: 1rpx solid var(--color-border-light);
  flex-shrink: 0;
}

.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-ink);
  letter-spacing: -0.025em;
}

.refresh-btn {
  padding: 16rpx 32rpx;
  background: var(--color-primary);
  color: var(--color-text-inverse);
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.4;
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(43, 45, 66, 0.16);
}

.refresh-btn:active {
  background: var(--color-primary-deep);
  transform: translateY(-2rpx);
}

.refresh-btn[disabled] {
  opacity: 0.6;
}

/* ── 主内容区 ────────────────────────────── */
.main-content {
  flex: 1;
  padding: 24rpx 24rpx 120rpx;
  box-sizing: border-box;
}

/* ── 概览卡片 ────────────────────────────── */
.overview-card {
  background: var(--color-bg-card);
  border-radius: 24rpx;
  border: 1rpx solid var(--color-border-light);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(29, 31, 51, 0.04);
}

.grade-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid var(--color-border-light);
}

.grade-left {
  display: flex;
  flex-direction: column;
}

.grade-label {
  font-size: 24rpx;
  color: var(--color-text-muted);
  font-weight: 500;
  letter-spacing: 0.03em;
  margin-bottom: 12rpx;
}

.grade-value {
  font-size: 72rpx;
  font-weight: 800;
  color: var(--color-primary);
  letter-spacing: -0.04em;
  line-height: 1;
}

.grade-icon {
  font-size: 64rpx;
  width: 120rpx;
  height: 120rpx;
  background: var(--color-primary-faint);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ── 统计横排 ────────────────────────────── */
.stat-row {
  display: flex;
  align-items: stretch;
  padding-top: 28rpx;
  min-height: 120rpx;
}

.stat-chip {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
}

.chip-value {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-text-ink);
  letter-spacing: -0.03em;
  font-family: 'SF Mono', 'JetBrains Mono', 'Consolas', monospace;
  line-height: 1.2;
}

.chip-label {
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-top: 6rpx;
  letter-spacing: 0.02em;
}

.chip-divider {
  width: 1rpx;
  background: var(--color-border-light);
  margin: 12rpx 0;
}

/* ── 通用区块卡片 ────────────────────────────── */
.section-card {
  background: var(--color-bg-card);
  border-radius: 24rpx;
  border: 1rpx solid var(--color-border-light);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(29, 31, 51, 0.04);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-ink);
  letter-spacing: -0.02em;
}

.card-tag {
  font-size: 22rpx;
  color: var(--color-text-muted);
  background: var(--color-bg-page-2);
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

/* ── 知识点列表 ────────────────────────────── */
.kp-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.kp-item {
  background: var(--color-bg-card-soft);
  border-radius: 20rpx;
  padding: 24rpx;
  border: 1rpx solid var(--color-border-light);
  min-height: 88rpx;
}

.kp-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.kp-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-ink);
  flex: 1;
  letter-spacing: -0.01em;
  margin-right: 16rpx;
}

.kp-score {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-primary);
  font-family: 'SF Mono', 'Consolas', monospace;
  flex-shrink: 0;
}

.kp-progress-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.kp-progress-track {
  flex: 1;
  height: 16rpx;
  background: var(--color-border-light);
  border-radius: 8rpx;
  overflow: hidden;
}

.kp-progress-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.4s ease;
}

.kp-progress-fill.success {
  background: var(--color-success);
}

.kp-progress-fill.warning {
  background: var(--color-student);
}

.kp-progress-fill.exception {
  background: var(--color-error);
}

.kp-percent {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-text-muted);
  font-family: 'SF Mono', 'Consolas', monospace;
  min-width: 80rpx;
  text-align: right;
}

.kp-bottom {
  display: flex;
  justify-content: flex-end;
}

.kp-status {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 12rpx;
  letter-spacing: 0.02em;
}

.kp-status.success {
  background: var(--color-success-soft);
  color: var(--color-success);
}

.kp-status.warning {
  background: var(--color-warning-soft);
  color: var(--color-warning);
}

.kp-status.danger {
  background: var(--color-error-soft);
  color: var(--color-error);
}

.kp-status.info {
  background: var(--color-info-soft);
  color: var(--color-info);
}

/* ── 趋势柱状图 ────────────────────────────── */
.trend-card {
  padding: 16rpx 0 8rpx;
}

.trend-bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 320rpx;
  padding: 0 8rpx;
}

.bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
  min-width: 0;
}

.bar-wrapper {
  width: 32rpx;
  height: 200rpx;
  background: var(--color-bg-page-2);
  border-radius: 8rpx;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.bar-fill {
  width: 100%;
  background: linear-gradient(180deg, var(--color-primary) 0%, var(--color-student) 100%);
  border-radius: 8rpx;
  transition: height 0.4s ease;
}

.bar-value {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--color-text-muted);
  font-family: 'SF Mono', 'Consolas', monospace;
  margin-bottom: 4rpx;
}

.bar-label {
  font-size: 20rpx;
  color: var(--color-text-faint);
  letter-spacing: 0.01em;
}

/* ── 行为分布列表 ────────────────────────────── */
.behavior-list {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.behavior-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border-light);
  min-height: 88rpx;
}

.behavior-item:last-child {
  border-bottom: none;
}

.behavior-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.behavior-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.behavior-name {
  font-size: 28rpx;
  color: var(--color-text-body);
  font-weight: 500;
}

.behavior-value {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-ink);
  font-family: 'SF Mono', 'Consolas', monospace;
}

/* ── 学习统计列表 ────────────────────────────── */
.stats-list {
  display: flex;
  flex-direction: column;
}

.stats-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border-light);
  min-height: 88rpx;
}

.stats-row:last-child {
  border-bottom: none;
}

.stats-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-ink);
  font-family: 'SF Mono', 'Consolas', monospace;
  letter-spacing: -0.02em;
}

.stats-label {
  font-size: 26rpx;
  color: var(--color-text-muted);
}

/* ── 评估报告富文本 ────────────────────────────── */
.report-text {
  font-size: 28rpx;
  color: var(--color-text-body);
  line-height: 1.8;
}

/* ── 循环提升 ────────────────────────────── */
.loop-card {
  margin-bottom: 48rpx;
}

.loop-desc {
  font-size: 26rpx;
  color: var(--color-text-muted);
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.loop-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 4rpx;
}

.loop-row {
  display: flex;
  gap: 16rpx;
}

.loop-btn {
  width: 100%;
  height: 80rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  line-height: 1;
  border: none;
  margin: 0;
  box-sizing: border-box;
  transition: all 0.15s;
}

.loop-row .loop-btn {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.loop-btn::after {
  border: none;
}

.loop-btn-icon {
  font-size: 30rpx;
  line-height: 1;
}

.loop-btn-icon.small {
  font-size: 26rpx;
}

.loop-btn-label {
  font-size: inherit;
  font-weight: inherit;
  letter-spacing: 0.01em;
}

.loop-btn.primary {
  background: var(--color-primary);
  color: var(--color-text-inverse);
  box-shadow: 0 4rpx 14rpx rgba(43, 45, 66, 0.18);
}

.loop-btn.primary:active {
  background: var(--color-primary-deep);
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 18rpx rgba(43, 45, 66, 0.22);
}

.loop-btn.secondary {
  background: var(--color-student);
  color: var(--color-text-inverse);
  box-shadow: 0 3rpx 10rpx rgba(176, 81, 44, 0.16);
}

.loop-btn.secondary:active {
  background: #964527;
  transform: translateY(-2rpx);
}

.loop-btn.outline {
  background: transparent;
  color: var(--color-primary);
  border: 1rpx solid var(--color-border-strong);
}

.loop-btn.outline:active {
  background: var(--color-primary-faint);
  border-color: var(--color-primary);
  transform: translateY(-2rpx);
}

/* ── 空状态 ────────────────────────────── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  min-height: 176rpx;
}

.empty-text {
  font-size: 26rpx;
  color: var(--color-text-faint);
  letter-spacing: 0.02em;
}
