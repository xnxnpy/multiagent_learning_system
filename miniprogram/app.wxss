/* ============================================================
 *  智学优培小程序 — 设计令牌 & 全局样式  「学术编辑风格」
 *  —— 暖中性 · 深墨蓝 · 编辑级排版 · 角色辅色 · 纸张质感
 * ============================================================ */

page {
  /* ── 主色：深邃墨蓝（非冷蓝AI风）─────────────────── */
  --color-primary: #2B2D42;
  --color-primary-deep: #1D1E30;
  --color-primary-soft: #4A4E7C;
  --color-primary-light: #6B7AA1;
  --color-primary-pale: #EDEEF5;
  --color-primary-faint: #F5F5FA;

  /* ── 辅色：各角色专属暖调 ──────────────────────────── */
  --color-student: #B0512C;
  --color-student-soft: #D97757;
  --color-student-pale: #FBF1EA;

  --color-teacher: #3D6B4F;
  --color-teacher-soft: #D9E5DE;
  --color-teacher-pale: #EEF4F0;

  --color-admin: #70293C;
  --color-admin-soft: #E9D5DC;
  --color-admin-pale: #F5E9ED;

  /* ── 功能色 ────────────────────────────────────── */
  --color-success: #16A34A;
  --color-success-soft: #86EFAC;
  --color-warning: #D97706;
  --color-warning-soft: #FDE68A;
  --color-error: #DC2626;
  --color-error-soft: #FECACA;
  --color-info: #2563EB;
  --color-info-soft: #93C5FD;

  /* ── 背景：纸张质感暖中性 ─────────────────────────── */
  --color-bg-page: #F7F5F0;
  --color-bg-page-2: #EFECE5;
  --color-bg-card: #FFFFFF;
  --color-bg-card-soft: #FAF8F4;
  --color-bg-sidebar: #FCFBF8;

  /* ── 文字：编辑级层次 ────────────────────────────── */
  --color-text-ink: #1A1B2E;
  --color-text-body: #2C2E44;
  --color-text-muted: #6B7280;
  --color-text-faint: #9CA3AF;
  --color-text-inverse: #FFFFFF;

  /* ── 边框：柔和非机械 ────────────────────────────── */
  --color-border: #D1D5DB;
  --color-border-light: #E5E7EB;
  --color-border-strong: #9CA3AF;

  /* ── 排版 ────────────────────────────────────── */
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI',
    'PingFang SC', 'Microsoft YaHei', 'Helvetica Neue', Arial,
    'Noto Sans SC', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--color-text-body);
  background: var(--color-bg-page);
}

/* ── 通用容器 ────────────────────────────────────── */
.container {
  min-height: 100vh;
  background: var(--color-bg-page);
}

/* ── 按钮：编辑级 ─────────────────────────────────── */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.2s;
  padding: 20rpx 44rpx;
}

.btn-primary {
  background: var(--color-primary);
  color: var(--color-text-inverse);
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(43, 45, 66, 0.15);
}

.btn-primary:active {
  background: var(--color-primary-deep);
  transform: translateY(-2rpx);
  box-shadow: 0 8rpx 20rpx rgba(43, 45, 66, 0.22);
}

.btn-student {
  background: var(--color-student);
  color: var(--color-text-inverse);
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(176, 81, 44, 0.18);
}

.btn-student:active {
  background: #964527;
}

.btn-outline {
  background: transparent;
  color: var(--color-primary);
  border: 2rpx solid var(--color-border-strong);
  padding: 18rpx 42rpx;
}

.btn-outline:active {
  border-color: var(--color-primary);
  color: var(--color-primary-deep);
  background: var(--color-primary-faint);
}

.btn-ghost {
  background: var(--color-primary-faint);
  color: var(--color-primary);
  border: none;
}

/* ── 卡片：纸张堆叠 ────────────────────────────────── */
.card {
  background: var(--color-bg-card);
  border-radius: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(29, 31, 51, 0.05),
              0 2rpx 4rpx rgba(29, 31, 51, 0.04);
  border: 1rpx solid var(--color-border-light);
}

.card-soft {
  background: var(--color-bg-card-soft);
  border-radius: 28rpx;
  border: 1rpx solid var(--color-border-light);
}

/* ── 页面顶部栏 ────────────────────────────────────── */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
  background: var(--color-bg-card);
  border-bottom: 1rpx solid var(--color-border-light);
}

.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-ink);
  letter-spacing: -0.025em;
}

.page-subtitle {
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-top: 6rpx;
}

/* ── 统计卡片 ────────────────────────────────────── */
.stat-card {
  background: var(--color-bg-card);
  border-radius: 28rpx;
  border: 1rpx solid var(--color-border-light);
  box-shadow: 0 2rpx 8rpx rgba(29, 31, 51, 0.05);
  padding: 36rpx;
  position: relative;
  overflow: hidden;
}

.stat-card::after {
  content: '';
  position: absolute;
  top: 0; right: 0;
  width: 160rpx; height: 160rpx;
  border-radius: 50%;
  transform: translate(40%, -40%);
  opacity: 0.06;
  background: currentColor;
  pointer-events: none;
}

.stat-label {
  font-size: 24rpx;
  color: var(--color-text-muted);
  font-weight: 500;
  margin-bottom: 8rpx;
  letter-spacing: 0.02em;
}

.stat-value {
  font-size: 64rpx;
  font-weight: 800;
  letter-spacing: -0.035em;
  color: var(--color-text-ink);
  line-height: 1;
}

/* ── 标签徽章（编辑感小方块，非AI药丸）────────── */
.chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 24rpx;
  font-size: 22rpx;
  font-weight: 500;
  border-radius: 12rpx;
  letter-spacing: 0.02em;
  line-height: 1.6;
  border: 1rpx solid transparent;
}

.chip-ink { background: var(--color-primary-pale); color: var(--color-primary-deep); }
.chip-student { background: var(--color-student-pale); color: var(--color-student); }
.chip-success { background: var(--color-success-soft); color: var(--color-success); }
.chip-warning { background: var(--color-warning-soft); color: var(--color-warning); }
.chip-error { background: var(--color-error-soft); color: var(--color-error); }
.chip-info { background: var(--color-info-soft); color: var(--color-info); }
.chip-muted { background: var(--color-bg-page-2); color: var(--color-text-muted); }

/* ── 空状态 ──────────────────────────────────────── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 48rpx;
  color: var(--color-text-faint);
  text-align: center;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--color-bg-page-2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  margin-bottom: 24rpx;
  opacity: 0.8;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-body);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: var(--color-text-muted);
  max-width: 600rpx;
  line-height: 1.75;
}

/* ── 输入框：编辑风（非粗线框）───────────────────────── */
.input-field {
  height: 88rpx;
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: 20rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: var(--color-text-body);
  transition: all 0.15s;
}

.input-field:focus {
  border-color: rgba(43, 45, 66, 0.3);
  box-shadow: 0 0 0 4rpx rgba(43, 45, 66, 0.06);
}

.textarea-field {
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: var(--color-text-body);
  width: 100%;
  box-sizing: border-box;
}

/* ── 代码块：白底 github 浅色主题 ─────────────────── */
.code-block {
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx solid var(--color-border-light);
  overflow: hidden;
}

.code-block .hljs,
.code-block pre {
  background: #fff !important;
  color: #24292e !important;
  padding: 24rpx !important;
  border-radius: 0 !important;
  overflow-x: auto;
  font-family: 'SF Mono', 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
  font-size: 24rpx;
  line-height: 1.6;
}

/* ── 卡片头部装饰条 ───────────────────────────────── */
.card-accent {
  position: relative;
}
.card-accent::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 8rpx;
  height: 100%;
  border-top-left-radius: 28rpx;
  border-bottom-left-radius: 28rpx;
  background: var(--color-primary);
}
.card-accent.card-accent-student::before { background: var(--color-student); }
.card-accent.card-accent-teacher::before { background: var(--color-teacher); }
.card-accent.card-accent-admin::before { background: var(--color-admin); }

/* ── 辅助工具类 ─────────────────────────────────── */
.mt-1 { margin-top: 8rpx; }
.mt-2 { margin-top: 16rpx; }
.mt-3 { margin-top: 24rpx; }
.mt-4 { margin-top: 32rpx; }
.mt-5 { margin-top: 40rpx; }
.mt-6 { margin-top: 48rpx; }
.mt-8 { margin-top: 64rpx; }
.mb-1 { margin-bottom: 8rpx; }
.mb-2 { margin-bottom: 16rpx; }
.mb-3 { margin-bottom: 24rpx; }
.mb-4 { margin-bottom: 32rpx; }
.mb-5 { margin-bottom: 40rpx; }
.mb-6 { margin-bottom: 48rpx; }

.weight-semibold { font-weight: 600; }
.weight-bold { font-weight: 700; }

.eyebrow {
  font-size: 22rpx;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-text-muted);
  font-weight: 600;
}
