# ============================================
# 应用基础配置
# ============================================
APP_NAME="智学优培"
DEBUG=True
SECRET_KEY="your_secret_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# MySQL 8.0 数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=ai_learning

# Redis 5 配置（同时作为 Celery broker 和 result backend）
REDIS_URL=redis://localhost:6379/0

# ChromaDB 持久化目录
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION=learning_resources

# Neo4j 知识图谱数据库配置（可选）
# 默认端口：7474（HTTP）、7687（Bolt）
# 不安装时知识图谱功能降级为 MySQL JSON 存储
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# JWT 配置
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ============================================
# 讯飞星火大模型配置（强制使用）
# 文档：https://www.xfyun.cn/doc/spark/
# ============================================
#
# 认证方式说明：
# ┌────────────────────────────────────────────────────┐
# │ 协议        │ 凭证                           │ 说明          │
# ├─────────────┼─────────────────────────────────┼──────────────┤
# │ HTTP API    │ 每个模型独立的 API Password     │ Bearer token  │
# │ WebSocket   │ APP_ID + API_KEY + API_SECRET  │ HMAC-SHA256   │
# └────────────────────────────────────────────────────┘
#
# WebSocket 共用凭证
XUNFEI_APP_ID=your_xunfei_app_id
XUNFEI_API_KEY=your_xunfei_api_key
XUNFEI_API_SECRET=your_xunfei_api_secret

# HTTP API - 每个模型独立的 APIPassword
# 请在讯飞控制台对应模型版本页面获取
XUNFEI_API_PASSWORD_LITE=your_xunfei_api_password_lite
XUNFEI_API_PASSWORD_PRO=your_xunfei_api_password_pro
XUNFEI_API_PASSWORD_PRO_128K=your_xunfei_api_password_pro_128k
XUNFEI_API_PASSWORD_ULTRA=your_xunfei_api_password_ultra
XUNFEI_API_PASSWORD_X1=your_xunfei_api_password_x1
XUNFEI_API_PASSWORD_X2=your_xunfei_api_password_x2
XUNFEI_API_PASSWORD_X2_FLASH=your_xunfei_api_password_x2_flash

# 模型选择
# - lite     : Spark Lite（轻量级）
# - pro      : Spark Pro（推荐日常使用）
# - ultra-32k: Spark Ultra-32K（32K上下文）
# - x1.5/2   : Spark X2（最新版本）
# - x2-flash : Spark X2-Flash（快速响应）
XUNFEI_MODEL=ultra-32k
XUNFEI_REASONING_MODEL=x2-flash

# ============================================
# Celery 异步任务配置
# ============================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================
# 多模态资源生成配置（可选）
# ============================================

# Stable Diffusion API（用于生成配图）
# API地址：http://localhost:7860/sdapi/v1/txt2img
SD_API_URL=http://localhost:7860/sdapi/v1/txt2img
SD_API_KEY=your_sd_api_key

# 讯飞图片生成服务（使用 XUNFEI_API_KEY/XUNFEI_API_SECRET 鉴权）
# 接口文档: https://www.xfyun.cn/doc/spark/图片生成.html
QWEN_IMAGE_APP_ID=your_qwen_image_app_id
QWEN_IMAGE_MODEL_ID=xopqwentti20b
QWEN_IMAGE_API_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2.1/tti

# StableDiffusion XL
SDXL_APP_ID=your_sdxl_app_id
SDXL_MODEL_ID=xssdxl
SDXL_API_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2.1/tti

# Z-Image-Turbo
ZIMAGE_TURBO_APP_ID=your_zimage_turbo_app_id
ZIMAGE_TURBO_MODEL_ID=xopzimageturbo
ZIMAGE_TURBO_API_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2.1/tti

# 多模态模型（图片理解 + 文本生成）
QWEN36_MULTIMODAL_APP_ID=your_qwen36_multimodal_app_id
QWEN36_MULTIMODAL_MODEL_ID=xopqwen36v35b
QWEN36_MULTIMODAL_API_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2.1/chat

QWEN35_MULTIMODAL_APP_ID=your_qwen35_multimodal_app_id
QWEN35_MULTIMODAL_MODEL_ID=xopqwen35v35b
QWEN35_MULTIMODAL_API_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2.1/chat

# 文本推理模型
QWEN3_17B_APP_ID=your_qwen3_17b_app_id
QWEN3_17B_MODEL_ID=xop3qwen1b7
QWEN3_17B_API_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2.1/chat

QWEN35_2B_APP_ID=your_qwen35_2b_app_id
QWEN35_2B_MODEL_ID=xop35qwen2b
QWEN35_2B_API_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2.1/chat

# DALL-E API（备选图片生成服务）
DALLE_API_KEY=your_dalle_api_key

# ============================================
# 讯飞 TTS 配置（PPT 视频配音）
# ============================================
XUNFEI_TTS_APP_ID=your_xunfei_tts_app_id
XUNFEI_TTS_WS_URL=wss://tts-api.xfyun.cn/v2/tts

# ============================================
# 讯飞 OCR 配置（通用文字识别 intsig，辅导场景图片题目识别）
# ============================================
XUNFEI_OCR_URL=https://api.xf-yun.com/v1/private/hh_ocr_recognize_doc

# ============================================
# 阿里云 OSS 配置（视频存储）
# ============================================
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_BUCKET_NAME=your_oss_bucket_name
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BASE_URL=

# PPT 视频临时文件目录
PPT_VIDEO_TEMP_DIR=./data/tmp/ppt_video

# ============================================
# 服务启动配置
# ============================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
